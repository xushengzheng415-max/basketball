# Server. With Linux host networking, the app binds this port on host loopback only.
PORT=3400
TZ=Asia/Shanghai
DATA_DIR=/app/data
STATE_FILE=/app/data/state.json
PUBLIC_BASE_URL=

# Safety gates. Keep every automation switch false until manual verification passes.
SERVICE_ENABLED=false
SCHEDULER_ENABLED=false
AUTO_CREATE_ENABLED=false
AUTO_REMIND_ENABLED=false

# Admin page and admin API use HTTP Basic authentication. Use a long random value.
ADMIN_TOKEN=

# OpenAI-compatible content generation.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5
OPENAI_WEB_SEARCH_TOOL=web_search
OPENAI_TIMEOUT_MS=120000
REQUIRE_SEARCH_PROVENANCE=true

# WeCom customer-contact API. Never commit real values.
WECOM_CORP_ID=
WECOM_CONTACT_SECRET=
WECOM_AGENT_ID=
WECOM_SENDER_USERID=
WECOM_CHAT_ID_LIST=
WECOM_API_BASE=https://qyapi.weixin.qq.com
WECOM_TIMEOUT_MS=10000

# Only sources from these comma-separated domains may enter a briefing.
# Example format: nba.com,cba.net.cn,sport.gov.cn
SOURCE_DOMAIN_ALLOWLIST=

# Daily schedule in Asia/Shanghai. Lookback is measured in hours.
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0
BRIEF_LOOKBACK_HOURS=72
NEWS_DEDUP_DAYS=7

# Optional reminder for a created-but-not-yet-sent group message task.
# WeCom still requires the group owner to confirm the final send.
REMINDER_HOUR=10
REMINDER_MINUTE=0
REMINDER_MIN_INTERVAL_MINUTES=60

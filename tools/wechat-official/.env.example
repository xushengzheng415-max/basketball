# 复制为 .env.local 后填写。不要提交真实密钥。
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 可二选一：已有永久封面素材 ID，或运行命令时传 --cover 图片路径。
WECHAT_THUMB_MEDIA_ID=

# 用于 AI 自动撰稿。若只把已有 JSON 写入草稿箱，可不填。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

ARTICLE_AUTHOR=蜂家日记编辑部

# 飞书自建应用机器人提醒。收件人邮箱和手机号二选一。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_USER_EMAIL=
FEISHU_USER_MOBILE=

<view class="page">
  <view wx:if="{{loading}}" class="page-state"><view class="spinner"></view><text>正在加载赛事...</text></view>
  <view wx:elif="{{loadFailed}}" class="page-state"><text class="state-title">赛事加载失败</text><button bindtap="retry">重新加载</button><button class="failed-delete" bindtap="deleteFailedTournament">删除此赛事</button></view>
  <block wx:elif="{{tournament}}">
    <view class="hero {{tournament.scenarioClass}}"><view class="hero-top"><view><text class="scenario">{{tournament.scenarioLabel}}</text><text class="title">{{tournament.name}}</text></view><view class="hero-actions"><view class="status {{tournament.statusClass}}">{{tournament.statusLabel}}</view><button wx:if="{{showHeaderInvite}}" class="invite-event" bindtap="createInvite">邀请球队</button><button wx:if="{{isCreator}}" class="edit-event" bindtap="editTournament">编辑赛事</button></view></view><text class="organization">{{tournament.organizationName}}</text><view class="hero-meta"><text>{{tournament.formatLabel}}</text><text>{{tournament.matchRuleText}}</text><text>{{tournament.pointsText}}</text><text wx:if="{{isLocalOnly}}" class="local-badge">待云端同步</text></view></view>
    <view class="tabs"><view wx:for="{{tabs}}" wx:key="key" class="{{item.className}}" data-key="{{item.key}}" bindtap="switchTab">{{item.label}}</view></view>

    <view wx:if="{{showMatchesTab}}" class="content">
      <view wx:if="{{showSetupGuide}}" class="setup-card">
        <view class="setup-success"><view>✓</view><text>赛事创建成功</text><span>现在可以邀请其他球队加入赛事</span></view>
        <view class="setup-steps"><view class="done"><b>1</b><text>本队已加入</text></view><view><b>2</b><text>邀请球队报名</text></view><view><b>3</b><text>审核后生成对阵</text></view></view>
        <view wx:if="{{isLocalOnly}}" class="local-note">赛事已经保存在本机。点击“邀请球队报名”后会先自动同步云端，再生成报名二维码。</view>
        <button class="setup-primary" bindtap="createInvite">邀请球队报名</button>
        <button wx:if="{{isLocalOnly}}" class="setup-secondary" bindtap="goTournamentHome">稍后，在赛事首页查看</button>
      </view>
      <view wx:elif="{{!hasMatches}}" class="empty-card"><text>对阵尚未发布</text><text>球队审核完成后，请到“管理”中生成并发布正式对阵。</text></view>
      <view wx:for="{{matches}}" wx:key="matchId" class="match-card">
        <view class="match-head"><text>{{item.stageText}}</text><text class="match-status {{item.statusClass}}">{{item.statusLabel}}</text></view>
        <view class="versus"><text class="team-name home">{{item.homeTeamName}}</text><text class="score">{{item.scoreText}}</text><text class="team-name">{{item.awayTeamName}}</text></view>
        <view class="match-actions"><button wx:if="{{item.showSwap}}" class="ghost" data-id="{{item.matchId}}" catchtap="swapHome">交换主客</button><button class="game-entry" data-id="{{item.matchId}}" bindtap="openGame">{{item.actionText}}</button></view>
      </view>
    </view>

    <view wx:if="{{showStandingsTab}}" class="content">
      <view wx:if="{{!hasStandings}}" class="empty-card"><text>暂无有效积分</text><text>原计分板完成比赛后，积分榜会根据赛果自动计算。</text></view>
      <view wx:for="{{standingSections}}" wx:key="groupKey" class="standing-card"><text class="section-title">{{item.label}}</text><view class="standing-head"><text>排名</text><text>球队</text><text>赛果</text><text>净胜</text><text>积分</text></view><view wx:for="{{item.rows}}" wx:for-item="row" wx:key="teamId" class="standing-row"><text>{{row.rank}}</text><text>{{row.name}}</text><text>{{row.recordText}}</text><text>{{row.differenceText}}</text><text class="points">{{row.points}}</text></view></view>
    </view>

    <view wx:if="{{showTeamsTab}}" class="content">
      <view class="section-bar"><text>正式参赛队</text><text>{{approvedTeams.length}} 支</text></view>
      <view wx:if="{{!hasApprovedTeams}}" class="empty-card"><text>还没有审核通过的球队</text></view>
      <view wx:for="{{approvedTeams}}" wx:key="teamId" class="team-card"><view class="team-logo">{{item.logoText}}</view><view class="team-copy"><text class="team-title">{{item.name}}</text><text>{{item.detailText}}</text></view><view class="team-side-actions"><view wx:if="{{item.isMyTeam}}" class="group-badge">我的报名 · 已通过</view><view wx:else class="group-badge">{{item.groupText}}</view><button wx:if="{{isCreator && item.canRemove}}" class="remove-approved-team" data-id="{{item.teamId}}" bindtap="removeApprovedTeam">移除</button></view></view>
      <block wx:if="{{hasPendingTeams}}"><view class="section-bar pending-bar"><text>待审核报名</text><text>{{pendingTeams.length}} 支</text></view><view wx:for="{{pendingTeams}}" wx:key="teamId" class="team-card pending"><view class="team-logo">{{item.logoText}}</view><view class="team-copy"><text class="team-title">{{item.name}}</text><text>{{item.detailText}}</text></view><view wx:if="{{isCreator}}" class="review-actions"><button data-id="{{item.teamId}}" data-decision="reject" bindtap="reviewTeam">驳回</button><button class="approve" data-id="{{item.teamId}}" data-decision="approve" bindtap="reviewTeam">通过</button></view><view wx:elif="{{item.isMyTeam}}" class="group-badge">我的报名 · 等待审核</view></view></block>
      <block wx:if="{{hasRejectedTeams}}"><view wx:for="{{rejectedTeams}}" wx:key="teamId" class="team-card pending"><view class="team-logo">{{item.logoText}}</view><view class="team-copy"><text class="team-title">{{item.name}}</text><text wx:if="{{item.isMyTeam}}">我的报名已被驳回：{{item.reviewDisplay}}</text><text wx:else>{{item.identityText}}</text></view><view wx:if="{{item.isMyTeam}}" class="group-badge">已驳回</view></view></block>
      <block wx:if="{{hasWithdrawnTeams}}"><view class="section-bar pending-bar"><text>已移出/退赛球队</text><text>{{withdrawnTeams.length}} 支</text></view><view wx:for="{{withdrawnTeams}}" wx:key="teamId" class="team-card pending"><view class="team-logo">{{item.logoText}}</view><view class="team-copy"><text class="team-title">{{item.name}}</text><text>原因：{{item.removeDisplay}}</text></view><view class="team-side-actions"><view class="group-badge">已退赛</view><button wx:if="{{isCreator}}" class="remove-approved-team" data-id="{{item.teamId}}" bindtap="clearWithdrawnTeam">删除</button></view></view></block>
    </view>

    <view wx:if="{{showManageTab}}" class="content">
      <view wx:if="{{!isCreator}}" class="empty-card"><text>参赛球队</text><text>本页由赛事创建者管理；你可以在“对阵”和“积分”中查看赛事进度。</text></view>
      <block wx:else>
        <view class="manage-card match-rule-card">
          <text class="section-title">比赛设置</text>
          <text class="section-desc">统一用于本赛事全部场次，进入原计分板后自动带入。</text>
          <view class="match-rule-settings">
            <view><text>比赛节数</text><view class="stepper"><button data-field="periodCount" data-delta="-1" bindtap="changeMatchRuleNumber">−</button><text>{{periodCount}} 节</text><button data-field="periodCount" data-delta="1" bindtap="changeMatchRuleNumber">+</button></view></view>
            <view><text>每节时长</text><view class="stepper"><button data-field="periodMinutes" data-delta="-1" bindtap="changeMatchRuleNumber">−</button><text>{{periodMinutes}} 分钟</text><button data-field="periodMinutes" data-delta="1" bindtap="changeMatchRuleNumber">+</button></view></view>
          </view>
          <button class="match-rule-save" loading="{{matchRulesSaving}}" bindtap="saveMatchRules">保存比赛设置</button>
        </view>
        <view wx:if="{{isLocalOnly}}" class="manage-card local-manage"><text class="section-title">邀请球队</text><text class="section-desc">点击后先同步赛事，再生成可转发的小程序码和报名入口。</text><button class="primary" bindtap="createInvite">同步并邀请球队</button><button class="outline" bindtap="goTournamentHome">稍后处理</button></view>
        <block wx:else>
           <view class="manage-card"><view class="manage-head"><view><text class="section-title">邀请球队</text><text class="section-desc">{{tournament.registrationText}}</text></view><button wx:if="{{tournament.registrationOpen}}" class="small-primary" bindtap="createInvite">生成邀请</button></view><button wx:if="{{showStartRecruiting}}" class="primary" bindtap="startRecruiting">开始球队招募</button><button wx:if="{{tournament.registrationOpen}}" class="danger-link" bindtap="closeRegistration">关闭球队招募</button></view>
          <view class="manage-card"><text class="section-title">对阵编排</text><text class="section-desc">只生成轮次和球队对阵，不设置日期、时间与场馆。</text><picker mode="selector" range="{{formatOptions}}" value="{{formatIndex}}" bindchange="onFormatChange"><view class="picker"><text>{{selectedFormatText}}</text><text>›</text></view></picker><view wx:if="{{showGroupSettings}}" class="group-settings"><view><text>分组数</text><view class="stepper"><button data-field="groupCount" data-delta="-1" bindtap="changeScheduleNumber">−</button><text>{{groupCount}}</text><button data-field="groupCount" data-delta="1" bindtap="changeScheduleNumber">+</button></view></view><view><text>每组晋级</text><view class="stepper"><button data-field="advanceCount" data-delta="-1" bindtap="changeScheduleNumber">−</button><text>{{advanceCount}}</text><button data-field="advanceCount" data-delta="1" bindtap="changeScheduleNumber">+</button></view></view></view><button class="outline" bindtap="previewSchedule">生成对阵预览</button></view>
          <view wx:if="{{hasSchedulePreview}}" class="manage-card preview-card"><view class="section-bar"><text>对阵预览</text><text>{{previewCount}} 场</text></view><view wx:for="{{schedulePreview}}" wx:key="matchId" class="preview-row"><text>{{item.stageText}}</text><view><text>{{item.homeTeamName}}</text><b>VS</b><text>{{item.awayTeamName}}</text></view></view><button class="primary" bindtap="publishSchedule">确认并发布对阵</button></view>
           <button wx:if="{{showAdvanceKnockout}}" class="advance-btn" bindtap="advanceKnockout">生成下一轮淘汰赛</button>
           <button class="delete-event" bindtap="deleteTournament">删除赛事</button>
        </block>
      </block>
    </view>
  </block>

<view wx:if="{{showServiceBindPanel}}" class="mask" bindtap="closeServiceBindPanel">
  <view class="service-bind-sheet" catchtap="noop">
    <text class="invite-title">绑定服务号后邀请球队</text>
    <text class="service-bind-desc">请先扫码关注并绑定赛小蜂篮球服务号。绑定成功后，系统会自动进入球队邀请页面。</text>
    <image wx:if="{{serviceFollowQr}}" class="service-bind-qr single-bind-qr" src="{{serviceFollowQr}}" mode="aspectFit" show-menu-by-longpress="true" />
    <view wx:elif="{{serviceFollowLoading}}" class="service-bind-loading">正在生成服务号二维码...</view>
    <text wx:if="{{serviceFollowError}}" class="service-bind-error">{{serviceFollowError}}</text>
    <text wx:if="{{serviceFollowQr}}" class="service-auto-check">关注后无需操作，系统会自动检查绑定状态</text>
    <button wx:if="{{!serviceFollowQr}}" class="service-bind-button" loading="{{serviceFollowLoading}}" bindtap="enableCreatorServiceNotice">重新生成二维码</button>
    <button class="close" bindtap="closeServiceBindPanel">取消邀请</button>
  </view>
</view>

<view wx:if="{{showServiceAuthorizationPanel}}" class="mask" bindtap="closeServiceAuthorizationPanel">
  <view class="service-auth-sheet" catchtap="noop">
    <view class="service-auth-success">✓</view>
    <text class="invite-title">服务号关注成功</text>
    <text class="service-auth-desc">授权卡片已发送到服务号，请点击卡片完成授权</text>
    <button class="service-auth-refresh" loading="{{serviceFollowLoading}}" bindtap="refreshCreatorAuthorizationStatus">刷新授权状态</button>
    <text class="service-auth-fallback">未收到卡片？在服务号回复“授权”</text>
    <button class="close" bindtap="cancelCreatorInviteAuthorization">取消邀请</button>
  </view>
</view>

<view wx:if="{{showInvitePanel}}" class="mask" bindtap="closeInvitePanel">
  <view class="invite-panel" catchtap="noop">
    <text class="invite-title">邀请球队报名</text>
    <view wx:if="{{serviceFollowReady}}" class="service-bound-compact">
      <text>服务号账号已绑定</text><button bindtap="openCreatorServiceSubscription">管理通知授权</button>
    </view>
    <image wx:if="{{inviteQr}}" class="invite-qr" src="{{inviteQr}}" mode="aspectFit" bindtap="previewInviteQr" />
    <view wx:elif="{{inviteQrLoading}}" class="qr-loading">小程序码生成中，不影响转发和复制邀请码...</view>
    <view wx:else class="qr-loading">小程序码暂未生成</view>
    <text wx:if="{{inviteQrError}}" class="invite-qr-error">{{inviteQrError}}</text>
    <button wx:if="{{!inviteQr && !inviteQrLoading}}" class="qr-retry" bindtap="loadInviteQr">重试生成小程序码</button>
    <text class="invite-code">邀请码 {{inviteKey}}</text>
    <text class="invite-note">可先转发给微信好友或群，或复制邀请码；小程序码生成后可用于线下扫码。</text>
    <text wx:if="{{inviteActionText}}" class="invite-action-note">{{inviteActionText}}</text>
    <button class="primary" open-type="share">转发给微信好友或群</button>
    <button class="poster-btn" loading="{{generatingPoster}}" bindtap="generateInvitePoster">{{posterButtonText}}</button>
    <button wx:if="{{hasPoster}}" class="save-poster-btn" bindtap="saveInvitePoster">保存海报到相册</button>
    <button class="outline" bindtap="copyInvite">复制邀请码</button>
    <button class="close" bindtap="closeInvitePanel">关闭</button>
  </view>
</view>
  <canvas id="invitePosterCanvas" type="2d" class="poster-canvas"></canvas>
</view>

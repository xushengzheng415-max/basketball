page{background:#080b0e;color:#f5f7f8}.page{min-height:100vh;padding-bottom:60rpx;background:radial-gradient(circle at 100% 0,rgba(255,103,0,.2),transparent 30%),#080b0e;font-family:"PingFang SC","Microsoft YaHei",sans-serif}.nav{height:96rpx;padding-top:72rpx;padding-left:30rpx;display:flex;align-items:center;gap:14rpx;border-bottom:1rpx solid #252b30;font-size:25rpx;font-weight:800}.brand-dot{width:20rpx;height:20rpx;border:6rpx solid #ff7200;border-radius:50%}.hero{padding:58rpx 34rpx 44rpx;display:flex;flex-direction:column}.eyebrow{color:#ff8b28;font-size:22rpx;font-weight:900}.title{margin-top:16rpx;font-size:43rpx;line-height:1.3;font-weight:900}.meta{margin-top:14rpx;color:#919ba2;font-size:23rpx}.format{align-self:flex-start;margin-top:24rpx;padding:10rpx 16rpx;border-radius:99rpx;color:#ff9a43;background:#342014;font-size:21rpx}.card{margin:0 24rpx;padding:30rpx;border:1rpx solid #30373c;border-radius:20rpx;background:#151a1e}.card-title{display:block;margin-bottom:24rpx;font-size:30rpx;font-weight:900}.picker{display:flex;height:82rpx;align-items:center;justify-content:space-between;padding:0 20rpx;border:1rpx solid #384046;border-radius:13rpx;background:#0c1013;font-size:24rpx}.picker text:last-child{color:#ff8228;font-size:34rpx}.roster{display:flex;justify-content:space-between;margin-top:14rpx;color:#4bd1ae;font-size:20rpx}.field{margin-top:20rpx}.field>text{display:block;margin-bottom:10rpx;color:#b8c0c5;font-size:21rpx}.field input{box-sizing:border-box;width:100%;height:78rpx;padding:0 18rpx;border:1rpx solid #363e44;border-radius:12rpx;background:#0c1013;font-size:23rpx}.two{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.card button,.state button{height:82rpx;margin-top:22rpx;border:0;border-radius:41rpx;font-size:25rpx;font-weight:900;line-height:82rpx}.card button::after,.state button::after{border:0}.secondary{color:#ff8d35;background:#302117}.primary{color:#fff;background:linear-gradient(90deg,#ff7b13,#ff5800)}.notice{margin:20rpx 24rpx;padding:22rpx;border:1rpx solid #4d3a22;border-radius:13rpx;color:#c2a67f;background:#1b160f;font-size:21rpx;line-height:1.65}.state{display:flex;min-height:70vh;flex-direction:column;align-items:center;justify-content:center;gap:18rpx;padding:40rpx;color:#909aa1;text-align:center;font-size:23rpx;line-height:1.6}.state-title{color:#f5f7f8;font-size:34rpx;font-weight:900}.state button{min-width:220rpx;padding:0 28rpx;color:#fff;background:#ff6500}.success-icon{display:flex;width:96rpx;height:96rpx;align-items:center;justify-content:center;border-radius:50%;color:#fff;background:#16a27e;font-size:48rpx}.spinner{width:28rpx;height:28rpx;border:6rpx solid #353c41;border-top-color:#ff6a00;border-radius:50%;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}

.class-scope{display:flex;flex-direction:column;gap:7rpx;padding:18rpx;border-radius:13rpx;color:#8d979e;background:#0c1013;font-size:20rpx}.class-scope b{color:#f4f6f7;font-size:25rpx}.class-scope span{color:#ff8a31}.binding-hint{display:block;margin-top:16rpx;padding:15rpx 18rpx;border-radius:11rpx;color:#5fd6b7;background:#102a24;font-size:20rpx;line-height:1.55}.follow-card{margin:0 24rpx;padding:32rpx 28rpx;border:1rpx solid #36503f;border-radius:20rpx;background:#101a16;text-align:center}.follow-desc{display:block;margin:16rpx 10rpx;color:#a9b6ae;font-size:22rpx;line-height:1.65}.follow-qr{display:block;width:360rpx;height:360rpx;margin:20rpx auto;border-radius:14rpx;background:#fff}.follow-loading{height:260rpx;line-height:260rpx;color:#88968d;font-size:22rpx}.follow-error{display:block;margin:12rpx 0;color:#ef9a88;font-size:20rpx}.follow-card .secondary,.follow-card .primary{width:100%;margin-top:14rpx}
.created-team-hint{border:1rpx solid #2d8069;text-align:center;font-weight:900}
.state-secondary{color:#ff983f!important;background:#302117!important}.rejected-note{display:flex;flex-direction:column;gap:10rpx;margin:0 24rpx 18rpx;padding:22rpx;border:1rpx solid #6c3632;border-radius:16rpx;color:#efb0a8;background:#2a1a19;font-size:21rpx;line-height:1.55}.rejected-note text:first-child{color:#ff9185;font-size:26rpx;font-weight:900}
.state-follow{width:100%;margin-top:18rpx;padding:18rpx;border:1rpx solid #36503f;border-radius:16rpx;background:#101a16;box-sizing:border-box}.state-follow .follow-qr{width:300rpx;height:300rpx}.state-follow button{width:100%;margin-top:12rpx}.service-ready-text{display:block;margin-top:18rpx;color:#55d8b6;font-size:22rpx;font-weight:900}
.team-selection{margin-top:8rpx}.selection-title{display:block;color:#f4f6f7;font-size:27rpx;font-weight:900}.selection-desc{display:block;margin-top:7rpx;color:#8f999f;font-size:20rpx}.team-choice-list{display:grid;gap:14rpx;margin-top:20rpx}.card .team-choice{box-sizing:border-box;width:100%;height:auto;min-height:112rpx;margin:0;padding:16rpx 18rpx;border:1rpx solid #343d43;border-radius:16rpx;background:#0d1215;color:#fff;display:grid;grid-template-columns:76rpx minmax(0,1fr) auto;align-items:center;gap:16rpx;text-align:left;line-height:1.3}.card .team-choice::after{border:0}.card .team-choice.selected{border-color:#ff7200;background:#24180f;box-shadow:inset 0 0 0 1rpx #ff7200}.team-choice image,.team-choice-mark{width:76rpx;height:76rpx;border-radius:14rpx;background:#283138}.team-choice-mark{display:grid;place-items:center;color:#fff;font-size:30rpx;font-weight:900}.team-choice-copy{min-width:0}.team-choice-copy b,.team-choice-copy text{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.team-choice-copy b{font-size:26rpx}.team-choice-copy text{margin-top:8rpx;color:#8f9aa1;font-size:19rpx}.team-choice-state{padding:8rpx 12rpx;border-radius:99rpx;background:#252c31;color:#aab3b8;font-size:18rpx}.team-choice.selected .team-choice-state{background:#ff7200;color:#fff}.team-empty{margin-top:20rpx;padding:28rpx 20rpx;border:1rpx dashed #414a50;border-radius:16rpx;text-align:center}.team-empty b,.team-empty text{display:block}.team-empty text{margin-top:8rpx;color:#8f999f;font-size:20rpx}.card .primary[disabled]{opacity:.42;color:#aeb5b9;background:#343b40}

<view class="home-page">
  <view class="top-hero">
    <view class="brand-row">
      <view class="brand-left">
        <image class="brand-logo" src="{{staticAssets.brandLogo}}" mode="aspectFit" />
      </view>

    </view>

    <view wx:if="{{showLoginGuide}}" class="login-guide" bindtap="goLogin">
      <view class="login-guide-copy">
        <text class="login-guide-title">当前未登录</text>
        <text class="login-guide-desc">登录后可云端保存赛事、球队与比赛数据</text>
      </view>
      <text class="login-guide-action">去登录  ›</text>
    </view>

    <view class="section-label light">
      <view class="section-line"></view>
      <text>快速比赛</text>
    </view>

    <view class="quick-card">
      <image class="quick-card-bg" src="{{staticAssets.quickBackground}}" mode="aspectFill" />
      <view class="quick-copy">
        <text class="quick-title">快速开始一场比赛</text>
        <text class="quick-desc">设置队伍、节次和时长，立即进入计分</text>
        <button class="primary-btn" bindtap="goQuickMatch">开始比赛</button>
      </view>


      <view class="quick-stats">
        <view class="stat-item stat-button" data-filter="all" bindtap="openRecentMatches">
          <image class="stat-icon" src="{{staticAssets.statToday}}" mode="aspectFit" />
          <view>
            <text class="stat-label">全部比赛</text>
            <text class="stat-number">{{todayStats.total}}</text>
          </view>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item stat-button" data-filter="pending" bindtap="openRecentMatches">
          <image class="stat-icon" src="{{staticAssets.statPending}}" mode="aspectFit" />
          <view>
            <text class="stat-label">未结束</text>
            <text class="stat-number">{{todayStats.pending}}</text>
          </view>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item stat-button" data-filter="finished" bindtap="openRecentMatches">
          <image class="stat-icon" src="{{staticAssets.statFinished}}" mode="aspectFit" />
          <view>
            <text class="stat-label">已完成</text>
            <text class="stat-number">{{todayStats.finished}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="content-scroll">
    <view wx:if="{{hasTournamentTasks}}" class="tournament-task-panel">
      <view class="tournament-task-panel-head"><view><text>赛事待办</text><text>{{tournamentTaskCount}} 项待处理</text></view><text wx:if="{{tournamentTaskMoreCount}}">还有 {{tournamentTaskMoreCount}} 项</text></view>
      <view wx:for="{{tournamentTasks}}" wx:key="taskId" class="tournament-task-row" data-id="{{item.taskId}}" bindtap="openTournamentTask">
        <view class="tournament-task-row-main"><text class="tournament-task-row-title">{{item.taskTitle}}</text><text class="tournament-task-row-meta">{{item.taskMeta}}</text><text class="tournament-task-row-detail">{{item.taskDetail}}</text></view>
        <view class="tournament-task-row-action">{{item.taskAction}} <text>›</text></view>
      </view>
    </view>
    <view wx:elif="{{taskLoading}}" class="match-task-card task-loading-card">
      <view class="task-loading-line wide"></view>
      <view class="task-loading-line"></view>
      <view class="task-loading-line short"></view>
    </view>

    <view wx:elif="{{taskError}}" class="match-task-card task-error-card" bindtap="retryMatchTasks">
      <text class="task-role">比赛任务</text>
      <text class="task-title">任务加载失败</text>
      <text class="task-note">{{taskError}} · 点击重试</text>
    </view>

    <view wx:elif="{{hasMatchTasks}}" class="match-task-card" bindtap="openHomeTask">
      <view class="task-card-head">
        <text class="task-role">{{homeTask.roleText}}</text>
        <text class="task-status">{{homeTask.statusText}}</text>
      </view>
      <text class="task-title">{{homeTask.matchText}}</text>
      <text class="task-meta">{{homeTask.dateText}} · {{homeTask.venueText}}</text>
      <view class="task-progress">
        <view><text>任务状态</text><text>{{homeTask.statusText}}</text></view>
        <view><text>赛程版本</text><text>V{{homeTask.scheduleVersion}}</text></view>
        <view><text>待处理</text><text>{{homeTaskCount}}</text></view>
      </view>
      <view class="task-card-action">
        <text>{{homeTask.cardActionText}}</text>
        <text>›</text>
      </view>
    </view>

    <view wx:else class="match-task-card task-empty-card" bindtap="openTaskEntry">
      <view class="task-card-head">
        <text class="task-role">比赛任务</text>
        <text class="task-status">首页处理</text>
      </view>
      <view class="task-empty-symbol"><view></view><view></view><view></view></view>
      <text class="task-title task-empty-title">{{taskEmptyTitle}}</text>
      <text class="task-note task-empty-note">{{taskEmptyNote}}</text>
      <view class="task-card-action">
        <text>{{taskEmptyAction}}</text>
        <text>›</text>
      </view>
    </view>
  </view>

  <view wx:if="{{showTaskCenter}}" class="task-center-mask" catchtap="closeTaskCenter">
    <view class="task-center-sheet" catchtap="stopTaskBubble">
      <view class="task-center-handle"></view>
      <view class="task-center-head">
        <button wx:if="{{showTaskDetail}}" class="task-center-back" bindtap="showTaskList">‹</button>
        <view class="task-center-title-wrap">
          <text wx:if="{{showTaskDetail}}" class="task-center-title">比赛任务</text>
          <text wx:else class="task-center-title">我的比赛任务</text>
          <text class="task-center-subtitle">所有操作均在首页完成</text>
        </view>
        <button class="task-center-close" bindtap="closeTaskCenter">×</button>
      </view>

      <scroll-view wx:if="{{!showTaskDetail}}" class="task-center-list" scroll-y="true">
        <view wx:if="{{taskListEmpty}}" class="task-center-empty">
          <text>暂无比赛任务</text>
          <text>新任务会直接出现在首页</text>
        </view>
        <view wx:for="{{matchTasks}}" wx:key="cardId" class="task-list-item" data-id="{{item.matchTaskId}}" bindtap="selectMatchTask">
          <view class="task-list-top">
            <text class="task-list-role">{{item.roleText}}</text>
            <text class="task-list-status">{{item.statusText}}</text>
          </view>
          <text class="task-list-match">{{item.matchText}}</text>
          <text class="task-list-meta">{{item.dateText}} · {{item.venueText}}</text>
          <view class="task-list-action"><text>{{item.actionText}}</text><text>›</text></view>
        </view>
      </scroll-view>

      <scroll-view wx:else class="task-detail-scroll" scroll-y="true">
        <view class="task-detail-card">
          <view class="task-detail-tags"><text>{{selectedTask.roleText}}</text><text>{{selectedTask.statusText}}</text></view>
          <text class="task-detail-match">{{selectedTask.matchText}}</text>
          <view class="task-detail-row"><text>时间</text><text class="task-detail-value">{{selectedTask.dateText}}</text></view>
          <view class="task-detail-row"><text>场地</text><text class="task-detail-value">{{selectedTask.venueText}}</text></view>
          <view class="task-detail-row"><text>赛程</text><text class="task-detail-value">V{{selectedTask.scheduleVersion}}</text></view>
        </view>

        <view wx:if="{{selectedTask.isTeamTask}}" class="task-team-progress">
          <text class="task-block-title">本队赛前准备</text>
          <view class="task-team-grid">
            <view><text>比赛名单</text><text class="task-team-value">{{taskRosterStatus}}</text></view>
            <view><text>助教加入</text><text class="task-team-value">{{taskAssistantStatus}}</text></view>
          </view>
          <text class="task-block-note">名单、首发和助教均从本场任务进入，不跳转赛事或球员页面。</text>
        </view>

        <view class="task-detail-actions">
          <button class="task-primary-action" loading="{{taskActionBusy}}" disabled="{{taskActionBusy}}" bindtap="runTaskPrimaryAction">{{selectedTask.actionText}}</button>
          <button wx:if="{{selectedTask.canReject}}" class="task-reject-action" disabled="{{taskActionBusy}}" bindtap="rejectSelectedTask">拒绝任务</button>
        </view>
        <text class="task-wait-note">现场入口由数据管理员开放，开放不会自动开始计时。</text>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{showRosterEditor}}" class="roster-editor-mask" catchtap="closeRosterEditor">
    <view class="roster-editor-sheet" catchtap="stopTaskBubble">
      <view class="roster-editor-head">
        <view><text class="roster-editor-title">本场名单</text><text class="roster-editor-subtitle">参赛 {{rosterSelectedCount}} 人 · 首发 {{rosterStarterCount}} 人</text></view>
        <button class="task-center-close" bindtap="closeRosterEditor">×</button>
      </view>
      <view wx:if="{{rosterLocked}}" class="roster-locked-tip">比赛已启动，名单不可修改</view>
      <scroll-view class="roster-player-list" scroll-y="true">
        <view wx:if="{{rosterPlayersEmpty}}" class="roster-empty">本队球员库暂无数据，请由机构后台补齐后刷新首页。</view>
        <view wx:for="{{rosterPlayers}}" wx:key="playerId" class="{{item.rowClass}}" data-id="{{item.playerId}}" bindtap="toggleRosterPlayer">
          <view class="roster-number">{{item.number}}</view>
          <text class="roster-name">{{item.name}}</text>
          <button class="{{item.starterClass}}" data-id="{{item.playerId}}" catchtap="toggleRosterStarter">首发</button>
          <text class="roster-check">✓</text>
        </view>
      </scroll-view>
      <button class="roster-submit" loading="{{taskActionBusy}}" disabled="{{rosterLocked}}" bindtap="submitTaskRoster">提交本场名单</button>
    </view>
  </view>

  <sxf-tabbar active="home" tournament-badge-count="{{tournamentTaskCount}}" />
</view>

page {
  min-height: 100vh;
  background: #071017;
  color: #111827;
}

.home-page {
  position: relative;
  display: flex;
  width: 100%;
  height: 100vh;
  min-height: 0;
  flex-direction: column;
  overflow: hidden;
  background: #071017;
  box-sizing: border-box;
}

.top-hero {
  position: relative;
  flex: 0 0 auto;
  min-height: 560rpx;
  padding: 72rpx 28rpx 28rpx;
  overflow: hidden;
  color: #ffffff;
  background: radial-gradient(circle at 86% 50%, rgba(255, 88, 12, 0.44), transparent 30%), radial-gradient(circle at 20% 0%, rgba(255, 122, 24, 0.12), transparent 34%), linear-gradient(135deg, #020405 0%, #071017 58%, #0b0c0e 100%);
}

.top-hero::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: 0.22;
  background-image: linear-gradient(30deg, rgba(255, 94, 0, 0.14) 12%, transparent 12.5%, transparent 87%, rgba(255, 94, 0, 0.14) 87.5%), linear-gradient(150deg, rgba(255, 94, 0, 0.12) 12%, transparent 12.5%, transparent 87%, rgba(255, 94, 0, 0.12) 87.5%);
  background-size: 74rpx 128rpx;
}

.brand-row,
.section-label,
.quick-card,
.panel,
.custom-tabbar {
  position: relative;
  z-index: 1;
}

.brand-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.brand-logo {
  display: block;
  width: 430rpx;
  height: 142rpx;
  max-width: 100%;
}

.login-guide {
  position: relative;
  z-index: 1;
  display: flex;
  margin-top: 12rpx;
  padding: 18rpx 20rpx;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid rgba(255, 132, 42, 0.45);
  border-radius: 16rpx;
  background: rgba(11, 17, 22, 0.76);
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.18);
}

.login-guide-copy {
  min-width: 0;
  flex: 1;
}

.login-guide-title,
.login-guide-desc {
  display: block;
}

.login-guide-title {
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
}

.login-guide-desc {
  margin-top: 5rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.66);
  font-size: 20rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.login-guide-action {
  margin-left: 18rpx;
  flex: 0 0 auto;
  color: #ff8a22;
  font-size: 23rpx;
  font-weight: 900;
}
.campus-pill {
  display: flex;
  align-items: center;
  height: 58rpx;
  padding: 0 18rpx;
  border: 2rpx solid #ff6a16;
  border-radius: 999rpx;
  color: #ff8a22;
  font-size: 25rpx;
  font-weight: 800;
  background: rgba(0, 0, 0, 0.28);
}

.campus-arrow {
  margin-left: 8rpx;
  font-size: 22rpx;
}

.section-label {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 900;
}

.section-label.light {
  margin-top: 54rpx;
  color: #ffffff;
}

.section-line {
  width: 8rpx;
  height: 34rpx;
  margin-right: 14rpx;
  border-radius: 99rpx;
  background: linear-gradient(180deg, #ff8a18, #ff4b00);
}

.quick-card {
  position: relative;
  min-height: 312rpx;
  padding: 34rpx 28rpx 28rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 92, 0, 0.92);
  border-radius: 18rpx;
  background: radial-gradient(circle at 82% 42%, rgba(255, 94, 0, 0.34), transparent 30%), linear-gradient(135deg, rgba(5, 7, 9, 0.94), rgba(13, 16, 18, 0.9));
  box-shadow: 0 18rpx 42rpx rgba(0, 0, 0, 0.28);
}

.quick-copy {
  position: relative;
  z-index: 2;
  width: 430rpx;
}

.quick-title,
.quick-desc,
.stat-label,
.stat-number,
.team-name,
.match-meta {
  display: block;
}

.quick-title {
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.15;
}

.quick-desc {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 178rpx;
  height: 64rpx;
  margin: 30rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 14rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff4b00, #ff7418);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 64rpx;
}

.primary-btn::after {
  border: 0;
}

.court-art {
  position: absolute;
  right: 18rpx;
  top: 36rpx;
  width: 310rpx;
  height: 210rpx;
  opacity: 0.95;
}

.court-board {
  position: absolute;
  right: 8rpx;
  top: 34rpx;
  width: 168rpx;
  height: 120rpx;
  border: 6rpx solid #ff6a00;
  box-shadow: 0 0 22rpx rgba(255, 100, 0, 0.8);
}

.court-board::after {
  content: "";
  position: absolute;
  left: 42rpx;
  top: 28rpx;
  width: 72rpx;
  height: 52rpx;
  border: 5rpx solid #ff6a00;
}

.court-ball {
  position: absolute;
  left: 18rpx;
  top: 96rpx;
  width: 112rpx;
  height: 112rpx;
  border: 6rpx solid #ff8a18;
  border-radius: 50%;
  box-shadow: 0 0 26rpx rgba(255, 90, 0, 0.72);
}

.light-line {
  position: absolute;
  height: 4rpx;
  border-radius: 99rpx;
  background: #ff5a12;
  box-shadow: 0 0 18rpx rgba(255, 90, 0, 0.8);
}

.light-line.one {
  left: 0;
  right: 20rpx;
  top: 30rpx;
  transform: rotate(-16deg);
}

.light-line.two {
  left: 38rpx;
  right: 0;
  bottom: 30rpx;
  transform: rotate(-16deg);
}

.quick-stats {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 22rpx 0;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 16rpx;
  background: rgba(8, 12, 16, 0.88);
}

.stat-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  padding: 0 16rpx;
}

.stat-button {
  min-height: 74rpx;
  margin: 0 7rpx;
  border: 1rpx solid rgba(255, 112, 18, 0.14);
  border-radius: 13rpx;
  background: linear-gradient(180deg, rgba(255, 112, 18, 0.06), rgba(255, 255, 255, 0.015));
  box-sizing: border-box;
}

.stat-button:active {
  border-color: rgba(255, 112, 18, 0.68);
  background: rgba(255, 105, 12, 0.16);
  transform: translateY(1rpx);
}

.stat-icon {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
  border: 4rpx solid #ff6a00;
  border-radius: 50%;
}

.stat-icon.whistle {
  border-radius: 16rpx;
}

.stat-icon.done {
  border-radius: 10rpx;
}

.stat-label {
  color: #ffffff;
  font-size: 22rpx;
}

.stat-number {
  color: #ff6a00;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1;
}

.stat-divider {
  flex-shrink: 0;
  width: 1rpx;
  height: 66rpx;
  background: rgba(255, 255, 255, 0.22);
}

.content-scroll {
  position: relative;
  z-index: 2;
  display: flex;
  height: auto;
  min-height: 0;
  flex: 1;
  margin-top: -2rpx;
  padding: 12rpx 28rpx calc(120rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background: radial-gradient(circle at 92% 5%, rgba(255, 87, 0, 0.14), transparent 32%), linear-gradient(180deg, #071017 0%, #05090c 100%);
  box-sizing: border-box;
}

.panel {
  margin-bottom: 24rpx;
  padding: 26rpx 22rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(15, 23, 42, 0.08);
}

.version-panel {
  position: relative;
  display: flex;
  width: 100%;
  min-height: 0;
  flex: 1;
  margin: 0;
}

.match-task-card {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  min-height: 420rpx;
  flex: 1;
  flex-direction: column;
  padding: 28rpx 24rpx 22rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 117, 28, 0.94);
  border-radius: 24rpx;
  color: #fff;
  background: radial-gradient(circle at 88% 14%, rgba(255, 94, 0, 0.34), transparent 28%), linear-gradient(145deg, #08131c 0%, #0d1922 56%, #2b1208 100%);
  box-shadow: 0 18rpx 42rpx rgba(255, 91, 0, 0.18);
  box-sizing: border-box;
}

.tournament-task-panel { box-sizing: border-box; width: 100%; flex: none; margin-bottom: 20rpx; padding: 18rpx; border: 1rpx solid rgba(255, 129, 42, 0.58); border-radius: 22rpx; background: radial-gradient(circle at 92% 5%, rgba(255, 87, 0, 0.18), transparent 38%), linear-gradient(180deg, #071017 0%, #05090c 100%); box-shadow: 0 14rpx 32rpx rgba(0, 0, 0, 0.28); }
.tournament-task-panel-head { display: flex; align-items: center; justify-content: space-between; margin: 0 6rpx 14rpx; color: #aab4ba; font-size: 20rpx; }
.tournament-task-panel-head > view { display: flex; align-items: center; gap: 12rpx; }.tournament-task-panel-head > view text:first-child { padding: 7rpx 13rpx; border: 1rpx solid rgba(255, 129, 42, 0.5); border-radius: 99rpx; color: #ff9a48; background: rgba(255, 91, 0, 0.12); font-size: 21rpx; font-weight: 900; }
.tournament-task-row { display: flex; min-height: 126rpx; align-items: center; justify-content: space-between; margin-top: 10rpx; padding: 18rpx 18rpx 18rpx 20rpx; border: 1rpx solid rgba(255, 130, 44, 0.72); border-radius: 15rpx; background: linear-gradient(105deg, rgba(15, 29, 36, 0.98), rgba(18, 18, 20, 0.94)); box-shadow: inset 0 1rpx 0 rgba(255, 205, 156, 0.16), 0 8rpx 20rpx rgba(0, 0, 0, 0.35), 0 0 16rpx rgba(255, 96, 0, 0.14); }
.tournament-task-row:active { opacity: .72; }.tournament-task-row-main { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 7rpx; }.tournament-task-row-title { color: #fff; font-size: 27rpx; font-weight: 900; }.tournament-task-row-meta { overflow: hidden; color: #d4d9dc; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }.tournament-task-row-detail { overflow: hidden; color: #8f9aa1; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }.tournament-task-row-action { display: flex; width: 136rpx; height: 56rpx; flex: none; align-items: center; justify-content: center; gap: 6rpx; margin-left: 12rpx; padding: 0 12rpx; border-radius: 28rpx; color: #fff; background: linear-gradient(90deg, #ff7a10, #ff5900); box-sizing: border-box; font-size: 20rpx; font-weight: 900; white-space: nowrap; }

.match-task-card::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: 0.18;
  background-image: linear-gradient(30deg, rgba(255, 255, 255, 0.06) 12%, transparent 12.5%, transparent 87%, rgba(255, 255, 255, 0.06) 87.5%);
  background-size: 72rpx 124rpx;
}

.task-card-head,
.task-title,
.task-meta,
.task-progress,
.task-card-action,
.task-note {
  position: relative;
  z-index: 1;
}

.task-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.task-role,
.task-status {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 900;
}

.task-role {
  color: #ff9a48;
  border: 1rpx solid rgba(255, 129, 42, 0.55);
  background: rgba(255, 91, 0, 0.12);
}

.task-status {
  color: #bdf5d5;
  background: rgba(24, 180, 96, 0.14);
}

.task-title {
  display: block;
  margin-top: 26rpx;
  color: #fff;
  font-size: 43rpx;
  font-weight: 900;
  line-height: 1.18;
}

.task-meta,
.task-note {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 23rpx;
  line-height: 1.5;
}

.task-progress {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 24rpx;
}

.task-progress view {
  padding: 16rpx 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 13rpx;
  background: rgba(4, 10, 15, 0.66);
  text-align: center;
}

.task-progress text {
  display: block;
  color: rgba(255, 255, 255, 0.55);
  font-size: 18rpx;
}

.task-progress text:last-child {
  margin-top: 6rpx;
  color: #ff8328;
  font-size: 25rpx;
  font-weight: 900;
}

.task-card-action {
  display: flex;
  min-height: 74rpx;
  margin-top: auto;
  padding: 0 20rpx;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid rgba(255, 129, 38, 0.5);
  border-radius: 14rpx;
  color: #fff;
  background: linear-gradient(90deg, rgba(255, 87, 0, 0.9), rgba(255, 148, 28, 0.88));
  font-size: 25rpx;
  font-weight: 900;
}

.task-loading-card,
.task-error-card {
  justify-content: center;
}

.task-loading-line {
  width: 72%;
  height: 24rpx;
  margin-top: 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
}

.task-loading-line.wide { width: 92%; height: 38rpx; }
.task-loading-line.short { width: 48%; }

.task-empty-card {
  min-height: 420rpx;
  text-align: center;
}

.task-empty-symbol {
  display: flex;
  width: 190rpx;
  margin: 48rpx auto 4rpx;
  flex-direction: column;
  gap: 14rpx;
}

.task-empty-symbol view {
  height: 16rpx;
  border-radius: 99rpx;
  background: linear-gradient(90deg, #ff5a00, #ff9b30);
  box-shadow: 0 8rpx 20rpx rgba(255, 91, 0, 0.22);
}

.task-empty-symbol view:nth-child(2) { width: 74%; }
.task-empty-symbol view:nth-child(3) { width: 48%; }

.task-empty-title {
  margin-top: 26rpx;
  font-size: 42rpx;
  text-align: center;
}

.task-empty-note {
  margin-top: 12rpx;
  text-align: center;
}

.version-panel:active {
  transform: scale(0.992);
}

.version-ad {
  position: relative;
  display: flex;
  width: 100%;
  height: 100%;
  min-height: 0;
  flex: 1;
  flex-direction: column;
  padding: 28rpx 24rpx 22rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 123, 26, 0.86);
  border-radius: 24rpx;
  color: #ffffff;
  background: radial-gradient(circle at 88% 12%, rgba(255, 94, 0, 0.34), transparent 28%), linear-gradient(145deg, #071018 0%, #0c151c 54%, #261108 100%);
  box-shadow: 0 18rpx 42rpx rgba(0, 0, 0, 0.36);
  box-sizing: border-box;
}

.version-ad::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: 0.2;
  background-image: linear-gradient(118deg, transparent 0%, transparent 48%, rgba(255, 105, 24, 0.2) 48.5%, transparent 49%), linear-gradient(30deg, rgba(255, 255, 255, 0.05) 12%, transparent 12.5%, transparent 87%, rgba(255, 255, 255, 0.05) 87.5%);
  background-size: 210rpx 210rpx, 72rpx 124rpx;
}

.version-ad-head,
.version-kicker,
.version-title,
.version-desc,
.version-chain,
.version-benefits,
.version-conversion {
  position: relative;
  z-index: 2;
}

.version-ad-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.version-badge {
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(255, 126, 42, 0.72);
  border-radius: 999rpx;
  color: #ff8a2a;
  background: rgba(255, 92, 0, 0.1);
  font-size: 20rpx;
  font-weight: 900;
  white-space: nowrap;
}

.version-status {
  color: rgba(255, 255, 255, 0.58);
  font-family: Arial, sans-serif;
  font-size: 15rpx;
  font-weight: 700;
  letter-spacing: 1.5rpx;
  text-align: right;
}

.version-kicker,
.version-title,
.version-desc {
  display: block;
}

.version-kicker {
  margin-top: 22rpx;
  color: #ff7a20;
  font-size: 23rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.version-title {
  margin-top: 6rpx;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.1;
  letter-spacing: 2rpx;
}

.version-title text {
  display: block;
}

.version-title-accent {
  margin-top: 4rpx;
  color: #ff7a16;
  text-shadow: 0 8rpx 24rpx rgba(255, 92, 0, 0.2);
}

.version-desc {
  max-width: 570rpx;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 21rpx;
  line-height: 1.55;
}

.version-chain {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 20rpx;
}

.version-chain-item {
  min-width: 0;
  padding: 13rpx 7rpx 12rpx;
  border: 1rpx solid rgba(255, 126, 32, 0.24);
  border-radius: 13rpx;
  background: rgba(4, 9, 13, 0.64);
  box-sizing: border-box;
}

.version-chain-no,
.version-chain-title,
.version-chain-note {
  display: block;
}

.version-chain-no {
  color: #ff7518;
  font-family: Arial, sans-serif;
  font-size: 14rpx;
  font-weight: 900;
}

.version-chain-title {
  margin-top: 7rpx;
  color: #f7f8f8;
  font-size: 20rpx;
  font-weight: 900;
  white-space: nowrap;
}

.version-chain-note {
  margin-top: 5rpx;
  color: rgba(255, 255, 255, 0.45);
  font-size: 14rpx;
  line-height: 1.35;
}

.version-benefits {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 14rpx;
  margin-bottom: 14rpx;
}

.version-benefit {
  min-width: 0;
  padding: 14rpx 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 13rpx;
  background: rgba(10, 16, 21, 0.7);
  text-align: center;
}

.version-benefit text {
  display: block;
}

.version-benefit text:first-child {
  color: #f4f6f7;
  font-size: 20rpx;
  font-weight: 900;
  white-space: nowrap;
}

.version-benefit text:last-child {
  margin-top: 5rpx;
  color: rgba(255, 255, 255, 0.48);
  font-size: 15rpx;
  line-height: 1.35;
}

.growth-entry {
  border-color: rgba(255, 132, 35, 0.92);
  box-shadow: 0 18rpx 42rpx rgba(255, 91, 0, 0.16);
}

.version-conversion {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding: 17rpx 15rpx 17rpx 18rpx;
  border: 1rpx solid rgba(255, 125, 28, 0.52);
  border-radius: 14rpx;
  background: linear-gradient(100deg, rgba(255, 91, 0, 0.17), rgba(255, 137, 30, 0.05));
}

.version-conversion-label,
.version-conversion-note {
  display: block;
}

.version-conversion-label {
  color: #f5f6f7;
  font-size: 21rpx;
  font-weight: 900;
}

.version-conversion-note {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.48);
  font-size: 17rpx;
}

.version-conversion-action {
  min-width: 164rpx;
  padding: 14rpx 12rpx;
  border-radius: 12rpx;
  color: #fff;
  background: linear-gradient(90deg, #ff5700, #ff951d);
  box-shadow: 0 10rpx 24rpx rgba(255, 83, 0, 0.3);
  font-size: 24rpx;
  font-weight: 900;
  text-align: center;
}

.version-watermark {
  position: absolute;
  z-index: 1;
  right: 2rpx;
  top: 48rpx;
  color: rgba(255, 255, 255, 0.055);
  font-family: "Arial Black", Arial, sans-serif;
  font-size: 84rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  line-height: 1;
}

.version-orbit {
  position: absolute;
  z-index: 1;
  border: 1rpx solid rgba(255, 112, 28, 0.24);
  border-radius: 50%;
}

.orbit-one {
  right: -88rpx;
  top: -104rpx;
  width: 330rpx;
  height: 330rpx;
}

.orbit-two {
  right: 8rpx;
  top: -6rpx;
  width: 190rpx;
  height: 190rpx;
}

@media (max-height: 740px) {
  .top-hero {
    min-height: 520rpx;
    padding-top: 58rpx;
    padding-bottom: 20rpx;
  }

  .brand-logo {
    height: 112rpx;
  }

  .section-label.light {
    margin-top: 34rpx;
    margin-bottom: 16rpx;
  }

  .quick-card {
    min-height: 286rpx;
    padding-top: 28rpx;
    padding-bottom: 22rpx;
  }

  .version-ad {
    padding-top: 20rpx;
    padding-bottom: 18rpx;
  }

  .version-kicker {
    margin-top: 16rpx;
  }

  .version-chain,
  .version-benefits,
  .version-conversion {
    margin-top: 12rpx;
  }

  .version-title {
    font-size: 43rpx;
  }

  .version-desc {
    font-size: 19rpx;
  }

  .version-chain-item {
    padding-top: 10rpx;
    padding-bottom: 9rpx;
  }

  .version-benefit {
    padding-top: 10rpx;
    padding-bottom: 10rpx;
  }

  .version-conversion {
    padding: 13rpx 14rpx 13rpx 16rpx;
  }

  .version-conversion-label {
    font-size: 21rpx;
  }

  .version-conversion-action {
    min-width: 170rpx;
    padding: 11rpx 14rpx;
    font-size: 24rpx;
  }
}

.match-list {
  overflow: hidden;
  border: 1rpx solid #eceff3;
  border-radius: 16rpx;
}

.match-row {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 124rpx;
  padding: 10rpx 12rpx;
  border-bottom: 1rpx solid #eef0f3;
  box-sizing: border-box;
}

.match-row:last-child {
  border-bottom: 0;
}

.match-content {
  flex: 1;
  min-width: 0;
}

.match-main {
  display: flex;
  align-items: center;
  min-width: 0;
}

.team-side {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
  gap: 6rpx;
}

.team-side.right {
  justify-content: flex-start;
  text-align: left;
}

.team-logo {
  display: block;
  flex-shrink: 0;
  width: 50rpx;
  height: 50rpx;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.team-name {
  flex: 1;
  min-width: 0;
  color: #111827;
  font-size: 22rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team-side.home .team-name {
  text-align: right;
}

.score-side {
  flex: 0 0 128rpx;
  min-width: 0;
  text-align: center;
}

.score-line {
  display: flex;
  align-items: baseline;
  justify-content: center;
  font-family: Arial, sans-serif;
  font-weight: 900;
}

.score-main {
  color: #ff4b00;
  font-size: 42rpx;
}

.score-away,
.score-split {
  color: #111827;
  font-size: 42rpx;
}

.score-split {
  margin: 0 6rpx;
}

.match-meta {
  display: block;
  width: 100%;
  margin-top: 6rpx;
  color: #727984;
  font-size: 19rpx;
  line-height: 1.35;
  text-align: center;
  white-space: normal;
  word-break: break-all;
}

.status-icon {
  display: block;
  flex-shrink: 0;
  width: 54rpx;
  height: 50rpx;
}

.row-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  gap: 6rpx;
  margin-right: 6rpx;
}

.delete-match-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: #fff3ed;
  color: #ff4b00;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 38rpx;
}

.delete-match-btn::after {
  border: 0;
}

.row-arrow {
  flex-shrink: 0;
  width: 18rpx;
  margin-left: 2rpx;
  color: #8c929c;
  font-size: 34rpx;
}

.more-link {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  color: #727984;
  font-size: 24rpx;
}

.empty-card {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 130rpx;
  color: #727984;
  font-size: 24rpx;
}

.bottom-safe {
  height: 150rpx;
}

.custom-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  padding: 12rpx 0 calc(12rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
  background: rgba(5, 9, 12, 0.96);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #aeb4bd;
  font-size: 21rpx;
}

.tab-item.active {
  color: #ff6a00;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  background-position: center;
  background-repeat: no-repeat;
  background-size: contain;
}

.quick-card {
  background: #05080b;
}
.quick-card-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}
.court-art {
  display: none;
}
.stat-icon {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
}
.tab-icon {
  display: block;
  width: 44rpx;
  height: 44rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
}

/* Compact workbench stats and tab icons while preserving tap targets. */
.home-page .stat-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}
.home-page .tab-icon {
  width: 34rpx;
  height: 34rpx;
}

/* 首页比赛任务中心：裁判、球队与机构任务统一在工作台处理。 */
.task-center-mask,
.roster-editor-mask {
  position: fixed;
  z-index: 80;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.72);
}

.roster-editor-mask { z-index: 90; }

.task-center-sheet,
.roster-editor-sheet {
  width: 100%;
  height: 78vh;
  min-height: 900rpx;
  padding: 16rpx 24rpx calc(30rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  border-radius: 34rpx 34rpx 0 0;
  color: #fff;
  background: #09121c;
  box-shadow: 0 -20rpx 60rpx rgba(0, 0, 0, 0.44);
  box-sizing: border-box;
}

.roster-editor-sheet {
  height: 86vh;
  min-height: 980rpx;
}

.task-center-handle {
  width: 90rpx;
  height: 8rpx;
  margin: 0 auto 16rpx;
  border-radius: 99rpx;
  background: rgba(255, 255, 255, 0.2);
}

.task-center-head,
.roster-editor-head {
  display: flex;
  min-height: 92rpx;
  align-items: center;
  gap: 14rpx;
}

.task-center-title-wrap,
.roster-editor-head > view {
  flex: 1;
  min-width: 0;
}

.task-center-title,
.roster-editor-title {
  display: block;
  color: #fff;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.2;
}

.task-center-subtitle,
.roster-editor-subtitle {
  display: block;
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.5);
  font-size: 23rpx;
}

.task-center-back,
.task-center-close {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  margin: 0;
  padding: 0;
  flex: 0 0 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  color: #fff;
  background: #152131;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 76rpx;
}

.task-center-back::after,
.task-center-close::after,
.task-primary-action::after,
.task-reject-action::after,
.starter-button::after,
.roster-submit::after { border: 0; }

.task-center-list,
.task-detail-scroll {
  height: calc(100% - 112rpx);
}

.task-center-empty {
  display: flex;
  min-height: 420rpx;
  padding: 40rpx 24rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  box-sizing: border-box;
}

.task-center-empty text:first-child {
  color: #fff;
  font-size: 38rpx;
  font-weight: 900;
}

.task-center-empty text:last-child {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.5);
  font-size: 25rpx;
}

.task-list-item,
.task-detail-card,
.task-team-progress {
  margin-top: 18rpx;
  padding: 26rpx 24rpx;
  border: 2rpx solid rgba(255, 126, 35, 0.3);
  border-radius: 24rpx;
  background: linear-gradient(145deg, #101d29, #0b151f);
  box-sizing: border-box;
}

.task-list-top,
.task-detail-tags {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.task-list-role,
.task-detail-tags text {
  color: #ff913c;
  font-size: 25rpx;
  font-weight: 900;
}

.task-list-status,
.task-detail-tags text:last-child {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  color: #b8f5d0;
  background: rgba(31, 190, 102, 0.13);
}

.task-list-match,
.task-detail-match {
  display: block;
  margin-top: 18rpx;
  color: #fff;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.25;
}

.task-list-meta {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 24rpx;
  line-height: 1.45;
}

.task-list-action {
  display: flex;
  min-height: 68rpx;
  margin-top: 22rpx;
  padding: 0 18rpx;
  align-items: center;
  justify-content: space-between;
  border-radius: 15rpx;
  color: #fff;
  background: linear-gradient(90deg, #f2530a, #ff921f);
  font-size: 27rpx;
  font-weight: 900;
}

.task-detail-card { margin-top: 10rpx; }

.task-detail-row {
  display: flex;
  min-height: 76rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.task-detail-row:last-child { border-bottom: 0; }
.task-detail-row text { color: rgba(255, 255, 255, 0.5); font-size: 25rpx; }
.task-detail-value { color: #fff; font-size: 27rpx; font-weight: 800; text-align: right; }

.task-block-title {
  display: block;
  color: #fff;
  font-size: 30rpx;
  font-weight: 900;
}

.task-team-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.task-team-grid view {
  padding: 20rpx 16rpx;
  border-radius: 18rpx;
  background: #142333;
}

.task-team-grid text { display: block; }
.task-team-grid text { color: rgba(255, 255, 255, 0.5); font-size: 22rpx; }
.task-team-grid .task-team-value { margin-top: 8rpx; color: #ff9139; font-size: 30rpx; font-weight: 900; }

.task-block-note,
.task-wait-note {
  display: block;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.5);
  font-size: 23rpx;
  line-height: 1.5;
}

.task-detail-actions { margin-top: 24rpx; }

.task-primary-action,
.roster-submit {
  display: flex;
  width: 100%;
  min-height: 92rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  color: #fff;
  background: linear-gradient(90deg, #f34d08, #ff951d);
  font-size: 31rpx;
  font-weight: 900;
}

.task-reject-action {
  width: 100%;
  min-height: 82rpx;
  margin-top: 14rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 20rpx;
  color: #ff9b88;
  background: transparent;
  font-size: 28rpx;
  font-weight: 800;
}

.roster-locked-tip,
.roster-empty {
  margin-top: 14rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  color: #ffc399;
  background: rgba(255, 103, 23, 0.12);
  font-size: 25rpx;
  line-height: 1.5;
  text-align: center;
}

.roster-player-list {
  height: calc(100% - 226rpx);
  margin-top: 12rpx;
}

.roster-player {
  display: flex;
  min-height: 94rpx;
  margin-bottom: 12rpx;
  padding: 10rpx 14rpx;
  align-items: center;
  gap: 16rpx;
  border: 2rpx solid #223143;
  border-radius: 20rpx;
  background: #101b27;
  box-sizing: border-box;
}

.roster-player.selected {
  border-color: #ff7b27;
  background: rgba(255, 106, 20, 0.1);
}

.roster-number {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  flex: 0 0 62rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ff8d37;
  background: #1d2a38;
  font-size: 27rpx;
  font-weight: 900;
}

.roster-name {
  flex: 1;
  color: #fff;
  font-size: 29rpx;
  font-weight: 800;
}

.starter-button {
  min-width: 104rpx;
  min-height: 58rpx;
  margin: 0;
  padding: 0 14rpx;
  border: 2rpx solid #34475b;
  border-radius: 15rpx;
  color: rgba(255, 255, 255, 0.5);
  background: transparent;
  font-size: 24rpx;
  line-height: 58rpx;
}

.starter-button.active {
  border-color: #ff7b27;
  color: #fff;
  background: #e95a0c;
}

.roster-check {
  width: 36rpx;
  color: transparent;
  font-size: 30rpx;
  font-weight: 900;
}

.roster-player.selected .roster-check { color: #54d68a; }
.roster-submit { min-height: 86rpx; margin-top: 12rpx; }

@media (min-width: 700px) {
  .task-center-sheet,
  .roster-editor-sheet {
    width: 680rpx;
    margin: 0 auto;
    border-radius: 34rpx 34rpx 0 0;
  }
}

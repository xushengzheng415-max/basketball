<view class="page"
  ><view class="nav" style="padding-top:{{navTop}}px;height:{{navHeight}}px"
    ><button bindtap="goBack">返回</button><text>我的班级</text></view
  ><scroll-view class="scroll" scroll-y enhanced show-scrollbar="{{false}}"
    ><view style="height:{{navSpacer}}px"></view
    ><view class="loading" wx:if="{{loading}}">正在读取本人班级…</view
    ><view class="error" wx:elif="{{error}}">{{error}}</view
    ><view class="content" wx:else
      ><view class="class-card" wx:for="{{classes}}" wx:key="classId"
        ><text>{{item.name}}</text><text>{{item.courseName}}</text
        ><view
          ><text>{{item.studentCount}}名学员</text
          ><text>{{item.lessons}}节待执行课堂</text
          ><text>最近 {{item.nextDate}}</text></view
        ></view
      ><view class="empty" wx:if="{{!classes.length}}"
        ><text>尚未分配班级</text
        ><text>机构完成班级与排课设置后会自动显示</text></view
      ></view
    ></scroll-view
  ></view
>

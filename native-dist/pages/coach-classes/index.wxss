page{background:#06090c;color:#fff}.nav{position:fixed;z-index:5;left:0;right:0;display:flex;align-items:center;justify-content:center;background:#0a0f13}.nav button{position:absolute;left:22rpx;border:0;background:transparent;color:#ff8500}.nav text{font-size:29rpx;font-weight:800}.scroll{height:100vh}.content{padding:20rpx 28rpx}.loading,.error{padding-top:250rpx;text-align:center;color:#92999e}.class-card{margin-bottom:15rpx;padding:26rpx;border:1rpx solid #30383e;border-radius:21rpx;background:#141a1e}.class-card>text{display:block}.class-card>text:first-child{font-size:32rpx;font-weight:900}.class-card>text:nth-child(2){margin-top:7rpx;color:#ff8500}.class-card>view{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:20rpx}.class-card>view text{padding:8rpx 12rpx;border-radius:10rpx;background:#0e1418;color:#9da5aa;font-size:19rpx}.empty{padding-top:240rpx;text-align:center}.empty text{display:block;color:#8e969c}.empty text:first-child{color:#fff;font-size:30rpx;font-weight:800}.empty text:last-child{margin-top:10rpx}

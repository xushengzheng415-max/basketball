  align-items: center;
  gap: 8px;
  color: #31d3a8;
  background: rgba(20, 133, 103, .12);
}

.assistant-task-layout {
  height: 100%;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 290px;
  gap: 12px;
}

.assistant-task-main,

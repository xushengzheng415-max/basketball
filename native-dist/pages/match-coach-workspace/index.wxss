  font-size: 16px;
  font-weight: 800;
}

.assistant-task-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 9px;
}

.assistant-task-chip {
  min-height: 58px;
  padding: 10px;
  border: 1px solid #179877;
  border-radius: 12px;

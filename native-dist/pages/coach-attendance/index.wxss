page{background:#06090c;color:#fff}.nav{position:fixed;z-index:5;left:0;right:0;display:flex;align-items:center;justify-content:center;background:#0a0f13}.nav button{position:absolute;left:22rpx;border:0;background:transparent;color:#ff8500}.nav text{font-size:29rpx;font-weight:800}.scroll{height:100vh}.content{padding:20rpx 26rpx}.loading,.error{padding-top:250rpx;text-align:center;color:#92999e}.summary,.student-card{border:1rpx solid #30383e;border-radius:20rpx;background:#141a1e}.summary{padding:25rpx}.summary>text{display:block}.summary>text:first-child{font-size:34rpx;font-weight:900}.summary>text:nth-child(2){margin-top:8rpx;color:#a1a9ae}.summary>view{display:flex;justify-content:space-between;margin-top:20rpx;color:#ff8500;font-size:20rpx}.student-card{margin-top:14rpx;padding:20rpx}.student-head{display:flex;align-items:center}.student-head view{width:54rpx;height:54rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#30383e}.student-head text:nth-child(2){flex:1;margin-left:14rpx;font-size:26rpx;font-weight:800}.student-head text:last-child{color:#ff8500}.status-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin-top:18rpx}.status-grid button{height:62rpx;border:1rpx solid #3b444a;border-radius:12rpx;background:#10161a;color:#adb4b9;font-size:20rpx}.status-grid button.active{border-color:#45c75f;background:rgba(69,199,95,.13);color:#58d671}.status-grid button.active.danger{border-color:#ef5555;background:rgba(239,85,85,.12);color:#ff6969}.save{height:88rpx;margin-top:20rpx;border-radius:16rpx;background:linear-gradient(90deg,#ff6100,#ff9800);color:#fff;font-size:27rpx;font-weight:900}.empty{padding:45rpx;text-align:center;color:#777f85}.safe{height:70rpx}

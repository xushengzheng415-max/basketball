@import "./base.wxss";
@import "./board-overrides.wxss";
.coach-timeout-request{position:fixed;z-index:80;top:18rpx;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:10rpx;padding:10rpx 14rpx;border:1rpx solid #ff7a18;border-radius:14rpx;color:#fff;background:rgba(12,17,21,.96);box-shadow:0 8rpx 24rpx rgba(0,0,0,.4)}.coach-timeout-request view{min-width:250rpx}.coach-timeout-request b,.coach-timeout-request text{display:block}.coach-timeout-request text{margin-top:4rpx;color:#9ca7ad;font-size:17rpx}.coach-timeout-request button{height:50rpx;margin:0;padding:0 16rpx;border:0;border-radius:25rpx;color:#f1a095;background:#44211e;font-size:18rpx;line-height:50rpx}.coach-timeout-request button.approve{color:#fff;background:#168b6f}.coach-timeout-request button::after{border:0}

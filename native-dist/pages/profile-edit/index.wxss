.profile-edit-page {
  position: relative;
  min-height: 100vh;
  background: #05080b;
  overflow: hidden;
}

.page-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.top-area {
  position: relative;
  z-index: 1;
}

.status-bar {
  height: 44rpx;
}

.nav-row {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  height: 88rpx;
  padding: 0 30rpx;
}

.back-hit {
  position: absolute;
  left: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
}

.back-icon {
  width: 44rpx;
  height: 44rpx;
}

.nav-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
}

.content-area {
  position: relative;
  z-index: 1;
  padding: 30rpx 35rpx 60rpx;
}

.form-panel {
  width: 679rpx;
  margin: 0 auto;
  padding: 17rpx 31rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.12);
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 1rpx solid #eef1f5;
}

.form-row:last-child {
  border-bottom: 0;
}

.row-icon {
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.row-label {
  flex-shrink: 0;
  color: #333840;
  font-size: 28rpx;
  font-weight: 800;
}

.row-input,
.row-value {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  color: #202225;
  font-size: 26rpx;
  font-weight: 700;
  text-align: right;
}

.row-value.muted {
  color: #b4bac3;
}

.save-area {
  width: 679rpx;
  margin: 50rpx auto 0;
}

.save-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 94rpx;
  border-radius: 47rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff7a1a, #ff5b08);
  font-size: 32rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 28rpx rgba(255, 91, 8, 0.35);
}

<view class="mine-profile-page">
  <image class="page-bg" src="{{staticAssets.background}}" mode="aspectFill" />

  <view class="top-area">
    <view class="status-bar"></view>
    <view class="nav-row">
      <view class="back-hit" bindtap="goBack">
        <image class="back-icon" src="{{staticAssets.back}}" mode="aspectFit" />
      </view>
      <text class="nav-title">我的</text>
    </view>
  </view>

  <view class="content-area">
    <view class="profile-card">
      <view class="avatar-wrapper">
        <image wx:if="{{draft.avatarUrl}}" class="avatar-img" src="{{draft.avatarUrl}}" mode="aspectFill" />
        <image wx:else class="avatar-img" src="{{staticAssets.defaultAvatar}}" mode="aspectFit" />
        <button class="avatar-overlay" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar"></button>
      </view>
      <view class="profile-copy">
        <text class="profile-name">{{draft.nickName || '微信用户'}}</text>
        <view class="change-avatar-wrapper">
          <view class="change-avatar">更换头像</view>
          <button class="change-avatar-overlay" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar"></button>
        </view>
      </view>
    </view>

    <view class="form-panel">
      <view wx:for="{{formRows}}" wx:key="field" class="form-row">
        <image class="row-icon" src="{{item.icon}}" mode="aspectFit" />
        <text class="row-label">{{item.label}}</text>
        <text class="row-value {{item.valueClass}}">{{item.value}}</text>
          <image wx:if="{{item.showChevron}}" class="row-chevron" src="{{staticAssets.chevron}}" mode="aspectFit" />
      </view>
    </view>

    <view class="settings-panel">
      <view class="settings-title-row">
        <view class="settings-title-mark"></view>
        <text class="settings-title">常用设置</text>
      </view>
      <view class="settings-list">
        <view wx:for="{{commonSettingRows}}" wx:key="key" class="settings-row" data-url="{{item.url}}" data-label="{{item.label}}" bindtap="onSettingTap">
          <image class="settings-icon settings-icon-accent" src="{{item.icon}}" mode="aspectFit" />
          <text class="settings-label">{{item.label}}</text>
        <image class="settings-chevron" src="{{staticAssets.chevron}}" mode="aspectFit" />
        </view>
      </view>
    </view>

    <view class="settings-panel support-panel">
      <view class="settings-title-row">
        <view class="settings-title-mark"></view>
        <text class="settings-title">服务支持</text>
      </view>
      <view class="settings-list">
        <view wx:for="{{supportRows}}" wx:key="key" class="settings-row" data-url="{{item.url}}" data-label="{{item.label}}" bindtap="onSettingTap">
          <image class="settings-icon" src="{{item.icon}}" mode="aspectFit" />
          <text class="settings-label">{{item.label}}</text>
        <image class="settings-chevron" src="{{staticAssets.chevron}}" mode="aspectFit" />
        </view>
      </view>
    </view>

    <view class="page-actions">
      <view class="logout-button" bindtap="logout">
        <text>退出登录</text>
      </view>
    </view>

    <view class="version-footer">
      <view class="version-link" bindtap="openVersionLog">
        <text>版本 {{currentVersion}}</text>
        <text class="version-divider">·</text>
        <text class="version-action">查看更新日志</text>
      </view>
      <text class="technology-support">由赛小蜂篮球提供技术支持</text>
    </view>
  </view>

  <view wx:if="{{showVersionLog}}" class="version-modal-mask" catchtap="closeVersionLog">
    <view class="version-modal" catchtap="noop">
      <view class="version-modal-header">
        <view>
          <text class="version-modal-title">版本更新日志</text>
          <text class="version-modal-subtitle">当前版本 {{currentVersion}}</text>
        </view>
        <view class="version-modal-close" bindtap="closeVersionLog">×</view>
      </view>
      <scroll-view class="version-history" scroll-y="true">
        <view wx:for="{{versionHistory}}" wx:key="version" class="version-history-item">
          <view class="version-history-heading">
            <text class="version-history-number">v{{item.version}}</text>
            <text wx:if="{{item.current}}" class="version-current-badge">当前版本</text>
            <text class="version-history-date">{{item.date}}</text>
          </view>
          <view class="version-highlights">
            <view wx:for="{{item.highlights}}" wx:for-item="highlight" wx:key="*this" class="version-highlight-row">
              <view class="version-highlight-dot"></view>
              <text class="version-highlight-text">{{highlight}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <sxf-tabbar active="mine" />
</view>

page{min-height:100%;background:#080b0e;color:#f7f8f9}.page{min-height:100vh;padding-bottom:170rpx;background:radial-gradient(circle at 0 0,rgba(255,102,0,.24),transparent 34%),linear-gradient(180deg,#12171b,#07090b 52%);font-family:"PingFang SC","Microsoft YaHei",sans-serif}.hero{padding:112rpx 30rpx 34rpx}.eyebrow,.title,.subtitle,.create-title,.create-desc,.event-name,.metric-value,.metric-label{display:block}.eyebrow{color:#ff8a28;font-size:21rpx;font-weight:800;letter-spacing:5rpx}.title{margin-top:8rpx;font-size:52rpx;font-weight:900}.subtitle{margin-top:10rpx;color:#909aa2;font-size:23rpx}.create-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;padding:0 24rpx}.create-card{position:relative;min-height:190rpx;padding:26rpx 22rpx;border:1rpx solid rgba(255,255,255,.13);border-radius:24rpx;box-sizing:border-box;overflow:hidden}.class-card{background:linear-gradient(145deg,#52250a,#1b120c 68%)}.weekly-card{background:linear-gradient(145deg,#153a34,#0d1818 68%)}.create-icon{display:flex;width:58rpx;height:58rpx;align-items:center;justify-content:center;border-radius:16rpx;color:#fff;background:#ff6a00;font-size:28rpx;font-weight:900}.weekly-card .create-icon{background:#15a681}.create-copy{margin-top:18rpx}.create-title{font-size:29rpx;font-weight:900}.create-desc{margin-top:8rpx;color:#aeb6bc;font-size:20rpx}.create-arrow{position:absolute;right:18rpx;top:24rpx;color:rgba(255,255,255,.45);font-size:42rpx}.other-entry{display:flex;justify-content:space-between;margin:18rpx 24rpx 0;padding:20rpx 24rpx;border:1rpx solid #292f34;border-radius:16rpx;color:#9ca5ac;background:#12171b;font-size:22rpx}.other-entry text:last-child{color:#ff8a28}.list-panel{margin-top:28rpx;padding:0 24rpx}.role-tabs{display:grid;grid-template-columns:1fr 1fr;padding:7rpx;border-radius:17rpx;background:#171c20}.role-tab{display:flex;height:70rpx;align-items:center;justify-content:center;border-radius:12rpx;color:#8d969d;font-size:26rpx;font-weight:800}.role-tab.active{color:#fff;background:#ff6500;box-shadow:0 8rpx 20rpx rgba(255,101,0,.24)}.state-card{display:flex;min-height:270rpx;flex-direction:column;align-items:center;justify-content:center;gap:18rpx;margin-top:18rpx;border:1rpx dashed #30373c;border-radius:20rpx;color:#9aa3aa;background:#11161a;font-size:24rpx}.state-card button{height:64rpx;padding:0 30rpx;border:0;border-radius:32rpx;color:#fff;background:#ff6500;font-size:23rpx;line-height:64rpx}.state-card button::after{border:0}.empty-ball{color:#ff7420;font-size:58rpx}.empty-note{color:#69737b;font-size:20rpx}.loading-dot{width:24rpx;height:24rpx;border:6rpx solid #3b4248;border-top-color:#ff6a00;border-radius:50%;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}.tournament-list{padding-top:18rpx}.tournament-card{position:relative;margin-bottom:18rpx;padding:24rpx;border:1rpx solid #30373c;border-radius:22rpx;background:linear-gradient(145deg,#171d21,#101417);overflow:hidden}.tournament-card::before{position:absolute;left:0;top:0;bottom:0;width:7rpx;background:#ff6a00;content:""}.tournament-card.weekly-league::before{background:#12a982}.tournament-card.other-event::before{background:#7d8790}.card-head,.event-meta,.event-progress,.card-enter{display:flex;align-items:center}.card-head{justify-content:space-between}.scenario-badge,.status-badge{padding:7rpx 14rpx;border-radius:999rpx;font-size:19rpx;font-weight:800}.scenario-badge{color:#ff9b46;background:#352012}.weekly-league .scenario-badge{color:#49d4b2;background:#13312c}.other-event .scenario-badge{color:#c0c7cc;background:#293037}.status-badge{color:#aab2b8;background:#2b3136}.status-badge.recruiting{color:#ff9b42;background:#3a2414}.status-badge.active{color:#44d9b1;background:#12352d}.status-badge.completed{color:#a6adb3;background:#2b3034}.event-name{margin-top:20rpx;font-size:32rpx;font-weight:900}.event-meta{gap:18rpx;margin-top:10rpx;color:#8f989f;font-size:21rpx}.event-meta text+text{padding-left:18rpx;border-left:1rpx solid #3b4247}.event-progress{justify-content:space-between;margin-top:24rpx;padding:18rpx;border-radius:16rpx;background:#0a0e11}.event-progress>view{min-width:0;text-align:center}.metric-value{color:#fff;font-size:23rpx;font-weight:900}.metric-label{margin-top:6rpx;color:#69737a;font-size:17rpx}.pending-tip{margin-top:16rpx;padding:12rpx 16rpx;border-radius:10rpx;color:#ff9a43;background:#2e1d11;font-size:20rpx}.card-enter{justify-content:flex-end;margin-top:18rpx;color:#ff862b;font-size:22rpx;font-weight:800}.card-enter text{margin-left:8rpx;font-size:30rpx}

.sync-label{color:#ff9a43!important}

.invite-code-entry{display:flex;align-items:center;justify-content:space-between;margin:14rpx 24rpx 0;padding:20rpx 24rpx;border:1rpx solid #244b42;border-radius:16rpx;background:#10251f}.invite-code-entry>view{display:flex;flex-direction:column;gap:6rpx}.invite-code-entry>view text:first-child{color:#60d7b8;font-size:23rpx;font-weight:900}.invite-code-entry>view text:last-child{color:#7f8d91;font-size:19rpx}.invite-code-entry>text{color:#4ed1ae;font-size:21rpx}

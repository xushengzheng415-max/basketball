page {
  background: #05080b;
  color: #f7f8fa;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}
.education-page {
  position: relative;
  min-height: 100vh;
  background: #05080b;
}
.page-bg,
.page-shade {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
}
.page-bg {
  opacity: 0.28;
}
.page-shade {
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.05),
    #05080b 36%,
    #05080b
  );
}
.page-scroll {
  position: relative;
  z-index: 2;
  height: 100vh;
}
.loading-state {
  height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  color: #959da3;
}
.loading-ring {
  width: 58rpx;
  height: 58rpx;
  border: 7rpx solid #333b41;
  border-top-color: #ff7900;
  border-radius: 50%;
}
.hero {
  padding: 30rpx 36rpx 24rpx;
}
.state-kicker,
.state-title,
.state-copy,
.page-title,
.hero-copy,
.course-title,
.course-sub {
  display: block;
}
.state-kicker {
  color: #ff870d;
  font-size: 22rpx;
  font-weight: 800;
}
.page-title,
.state-title {
  margin-top: 8rpx;
  font-size: 44rpx;
  line-height: 1.25;
  font-weight: 900;
}
.hero-copy,
.state-copy {
  margin-top: 10rpx;
  color: #9ca4aa;
  font-size: 23rpx;
  line-height: 1.6;
}
.content {
  padding: 0 28rpx;
}
.invite-wrap,
.unbound-wrap {
  min-height: calc(100vh - 160rpx);
  padding: 40rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.invite-card,
.unbound-card,
.next-card,
.empty-card,
.section-card,
.metric-card {
  border: 1rpx solid rgba(255, 255, 255, 0.13);
  background: linear-gradient(
    145deg,
    rgba(24, 30, 35, 0.97),
    rgba(9, 13, 16, 0.97)
  );
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.35);
}
.invite-card,
.unbound-card {
  width: 100%;
  padding: 38rpx 30rpx;
  border-radius: 26rpx;
}
.identity-mark {
  width: 82rpx;
  height: 82rpx;
  margin: 0 auto 22rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 121, 0, 0.15);
  color: #ff8400;
  font-size: 32rpx;
  font-weight: 900;
}
.invite-card > .state-kicker,
.invite-card > .state-title,
.invite-card > .state-copy,
.unbound-card > .state-kicker,
.unbound-card > .state-title,
.unbound-card > .state-copy {
  text-align: center;
}
.invite-form {
  display: grid;
  gap: 10rpx;
  margin-top: 28rpx;
}
.invite-form text {
  color: #cbd0d4;
  font-size: 21rpx;
  font-weight: 700;
}
.invite-form input {
  height: 78rpx;
  margin-bottom: 8rpx;
  padding: 0 20rpx;
  border: 1rpx solid #384149;
  border-radius: 14rpx;
  background: #0a0f13;
  color: #fff;
  font-size: 25rpx;
}
.permission-line {
  display: grid;
  grid-template-columns: 70rpx 1fr;
  gap: 10rpx;
  margin-top: 14rpx;
  padding: 15rpx;
  border-radius: 13rpx;
  font-size: 20rpx;
}
.permission-line.allow {
  border: 1rpx solid rgba(71, 199, 103, 0.35);
  background: rgba(71, 199, 103, 0.08);
  color: #b0b8bd;
}
.permission-line.allow text:first-child {
  color: #55d874;
}
.permission-line.deny {
  border: 1rpx solid rgba(255, 84, 84, 0.3);
  background: rgba(255, 84, 84, 0.06);
  color: #b0b8bd;
}
.permission-line.deny text:first-child {
  color: #ff6868;
}
.primary-button {
  height: 88rpx;
  margin-top: 26rpx;
  border-radius: 16rpx;
  background: linear-gradient(90deg, #ff6100, #ff9b00);
  color: #fff;
  font-size: 27rpx;
  font-weight: 900;
}
.brand-logo {
  position: absolute;
  top: 80rpx;
  width: 310rpx;
}
.unbound-steps {
  display: grid;
  gap: 12rpx;
  margin-top: 26rpx;
}
.unbound-steps view {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx;
  background: #10161a;
  border-radius: 12rpx;
  color: #b6bdc2;
}
.unbound-steps b {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ff7900;
  color: #fff;
}
.error-copy {
  display: block;
  margin-top: 18rpx;
  color: #ff8e77;
  font-size: 20rpx;
  line-height: 1.5;
}
.next-card,
.empty-card,
.section-card {
  padding: 25rpx;
  border-radius: 22rpx;
}
.section-kicker {
  display: block;
  color: #ff870d;
  font-size: 21rpx;
}
.course-title {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 800;
}
.course-sub {
  margin-top: 10rpx;
  color: #a7afb4;
  font-size: 22rpx;
}
.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}
.action-row button {
  flex: 1;
  height: 72rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
}
.outline-button {
  border: 1rpx solid #ff7900;
  background: transparent;
  color: #ff8a13;
}
.primary-small {
  background: linear-gradient(90deg, #ff6100, #ff9900);
  color: #fff;
}
.empty-card {
  text-align: center;
}
.empty-card text {
  display: block;
  color: #a0a8ae;
}
.empty-card text:first-child {
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
}
.empty-card text:last-child {
  margin-top: 8rpx;
  font-size: 21rpx;
}
.metric-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 16rpx;
}
.metric-card {
  min-height: 142rpx;
  padding: 18rpx;
  border-radius: 18rpx;
}
.metric-card image {
  width: 36rpx;
  height: 36rpx;
}
.metric-card > text {
  display: block;
  margin-top: 8rpx;
  color: #a9b0b5;
  font-size: 19rpx;
}
.metric-card b {
  font-size: 36rpx;
}
.metric-card view text {
  margin-left: 5rpx;
  color: #ff870d;
  font-size: 18rpx;
}
.section-card {
  margin-top: 16rpx;
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 15rpx;
}
.section-head text:first-child {
  font-size: 29rpx;
  font-weight: 800;
}
.section-head text:last-child {
  color: #ff870d;
  font-size: 20rpx;
}
.lesson-row {
  min-height: 112rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.09);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.lesson-row view text {
  display: block;
}
.lesson-row view text:first-child {
  font-size: 24rpx;
  font-weight: 800;
}
.lesson-row view text:nth-child(2) {
  margin-top: 6rpx;
  color: #e6e8e9;
}
.lesson-row view text:nth-child(3) {
  margin-top: 5rpx;
  color: #858d93;
  font-size: 19rpx;
}
.lesson-row > text {
  color: #ff8a13;
  font-size: 19rpx;
}
.empty-line {
  padding: 34rpx 0;
  text-align: center;
  color: #777f85;
}
.secondary-wide {
  height: 78rpx;
  margin-top: 16rpx;
  border: 1rpx solid #ff7900;
  border-radius: 15rpx;
  background: transparent;
  color: #ff8a13;
  font-size: 24rpx;
}
.manager-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}
.manager-grid view {
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.13);
  border-radius: 18rpx;
  background: #12181d;
}
.manager-grid text {
  display: block;
  color: #a5adb2;
  font-size: 21rpx;
}
.manager-grid b {
  display: block;
  margin-top: 8rpx;
  font-size: 38rpx;
}
.manager-entry {
  height: 78rpx;
  margin-top: 12rpx;
  border: 1rpx solid #394249;
  border-radius: 14rpx;
  background: #10161a;
  color: #fff;
  font-size: 24rpx;
  text-align: left;
  padding-left: 22rpx;
}
.bottom-space {
  height: 190rpx;
}
.invite-wrap {
  min-height: auto;
  padding: 18rpx 24rpx 260rpx;
  align-items: flex-start;
}
.invite-card {
  padding: 34rpx 30rpx 38rpx;
  border-color: #364047;
  border-radius: 24rpx;
  background: #141a1e;
  box-shadow: 0 24rpx 70rpx rgba(0, 0, 0, 0.42);
}
.invite-card .identity-mark {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 12rpx;
  background: #342214;
  color: #ff870d;
  font-size: 28rpx;
}
.invite-verified {
  width: 180rpx;
  text-align: center;
  margin: 0 auto 16rpx;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(70, 199, 100, 0.1);
  color: #61d77b;
  font-size: 19rpx;
  font-weight: 700;
}
.invite-card > .state-kicker {
  font-size: 20rpx;
  letter-spacing: 1rpx;
}
.invite-card > .state-title {
  margin-top: 10rpx;
  font-size: 40rpx;
  letter-spacing: 0;
}
.invite-card > .state-copy {
  max-width: 560rpx;
  margin: 12rpx auto 0;
  color: #a8b0b6;
  font-size: 22rpx;
  line-height: 1.7;
}
.invite-form {
  gap: 12rpx;
  margin-top: 30rpx;
}
.invite-form > text {
  margin-top: 4rpx;
  color: #edf0f2;
  font-size: 24rpx;
  font-weight: 700;
}
.required-mark {
  color: #ff7a00;
}
.optional-mark {
  margin-left: 8rpx;
  color: #788188;
  font-size: 18rpx;
  font-weight: 400;
}
.invite-form input {
  height: 92rpx;
  margin: 0;
  padding: 0 22rpx;
  border-color: #424c54;
  border-radius: 15rpx;
  background: #0b1115;
  color: #fff;
  font-size: 28rpx;
}
.input-placeholder {
  color: #68727a;
  font-size: 24rpx;
}
.permission-title {
  display: block;
  margin-top: 28rpx;
  color: #edf0f2;
  font-size: 24rpx;
  font-weight: 800;
}
.permission-line {
  grid-template-columns: 86rpx 1fr;
  align-items: center;
  min-height: 74rpx;
  margin-top: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  font-size: 21rpx;
  line-height: 1.5;
}
.permission-line text:first-child {
  font-weight: 800;
}
.invite-card .primary-button {
  width: 100%;
  height: 104rpx;
  margin-top: 34rpx;
  padding: 0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 900;
  letter-spacing: 1rpx;
}

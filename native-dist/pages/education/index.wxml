<view class="education-page">
  <image class="page-bg" src="{{assets.background}}" mode="aspectFill" /><view
    class="page-shade"
  ></view>
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}"
    ><view style="height:{{navSpacer}}px"></view>
    <view class="loading-state" wx:if="{{showLoading}}"
      ><view class="loading-ring"></view><text>正在确认机构身份…</text></view
    >
    <view class="invite-wrap" wx:elif="{{showInvite}}"
      ><view class="invite-card"
        ><view class="identity-mark">教</view><view class="invite-verified">微信身份已确认</view
        ><text class="state-kicker">机构教练邀请</text
        ><text class="state-title">填写教练资料</text
        ><text class="state-copy"
          >请填写本人真实资料。提交后将绑定邀请机构，并进入教练工作台。</text
        ><view class="invite-form"
          ><text>教练姓名 <text class="required-mark">*</text></text
          ><input
            value="{{inviteName}}"
            bindinput="onInviteName"
            maxlength="20"
            placeholder="请输入本人真实姓名"
            placeholder-class="input-placeholder"
            confirm-type="next"
            cursor-spacing="150"
            adjust-position="{{true}}" /><text>手机号 <text class="required-mark">*</text></text
          ><input
            value="{{invitePhone}}"
            bindinput="onInvitePhone"
            type="number"
            maxlength="11"
            placeholder="请输入本人手机号"
            placeholder-class="input-placeholder"
            confirm-type="done"
            cursor-spacing="150"
            adjust-position="{{true}}" /></view
        ><button
          class="primary-button"
          loading="{{inviteSubmitting}}"
          disabled="{{inviteSubmitting}}"
          bindtap="acceptCoachInvite"
        >
          确认资料并加入机构
        </button></view
      ></view
    >
    <view class="unbound-wrap" wx:elif="{{showUnbound}}"
      ><image class="brand-logo" src="{{assets.logo}}" mode="widthFix" /><view
        class="unbound-card"
        ><view class="identity-mark">未</view
        ><text class="state-kicker">教务身份</text
        ><text class="state-title">尚未加入机构</text
        ><text class="state-copy"
          >请让机构负责人在PC教务中心生成“添加教练”二维码，再使用微信扫码。扫码后会先确认您的姓名和手机号，完成后自动进入教练端。</text
        ><view class="unbound-steps"
          ><view><b>1</b><text>机构PC生成邀请</text></view
          ><view><b>2</b><text>微信扫描小程序码</text></view
          ><view><b>3</b><text>确认资料并绑定</text></view></view
        ><text class="error-copy" wx:if="{{errorMessage}}"
          >{{errorMessage}}</text
        ><button class="primary-button" bindtap="refreshIdentity">
          我已扫码，重新检查
        </button></view
      ></view
    >
    <view wx:elif="{{showCoach}}"
      ><view class="hero"
        ><text class="state-kicker">{{organizationName}} · 教练端</text
        ><text class="page-title">{{displayName}}，今日教学</text
        ><text class="hero-copy"
          >只显示您本人负责的真实课堂与学员任务</text
        ></view
      ><view class="content"
        ><view
          class="next-card"
          wx:if="{{nextLesson}}"
          data-id="{{nextLesson.lessonId}}"
          bindtap="openLesson"
          ><text class="section-kicker">下一节课</text
          ><text class="course-title">{{nextLesson.className}}</text
          ><text class="course-sub"
            >{{nextLesson.lessonDate}}　{{nextLesson.startTime}}　{{nextLesson.venue}}</text
          ><text class="course-sub"
            >{{nextLesson.courseName}} · {{nextLesson.studentCount}}名学员</text
          ><view class="action-row"
            ><button
              class="outline-button"
              data-id="{{nextLesson.lessonId}}"
              catchtap="openLesson"
            >
              查看课堂</button
            ><button
              class="primary-small"
              data-id="{{nextLesson.lessonId}}"
              catchtap="openAttendance"
            >
              进入点名
            </button></view
          ></view
        ><view class="empty-card" wx:else
          ><text>近期没有待执行课堂</text
          ><text>校区完成排课后会自动出现在这里</text></view
        ><view class="metric-grid"
          ><view class="metric-card" wx:for="{{metrics}}" wx:key="label"
            ><image src="{{item.icon}}" mode="aspectFit" /><text
              >{{item.label}}</text
            ><view><b>{{item.value}}</b><text>{{item.unit}}</text></view></view
          ></view
        ><view class="section-card"
          ><view class="section-head"
            ><text>我的课堂</text><text>{{lessons.length}}节</text></view
          ><view
            class="lesson-row"
            wx:for="{{lessons}}"
            wx:key="lessonId"
            data-id="{{item.lessonId}}"
            bindtap="openLesson"
            ><view
              ><text>{{item.lessonDate}} {{item.startTime}}</text
              ><text>{{item.className}} · {{item.courseName}}</text
              ><text>{{item.venue}} · {{item.studentCount}}名学员</text></view
            ><text>{{item.status}}</text></view
          ><view class="empty-line" wx:if="{{lessonsEmpty}}"
            >暂无课堂数据</view
          ></view
        ><button class="secondary-wide" bindtap="openClasses">
          查看我的班级</button
        ><text class="error-copy" wx:if="{{errorMessage}}"
          >{{errorMessage}}</text
        ></view
      ></view
    >
    <view wx:elif="{{showManager}}"
      ><view class="hero"
        ><text class="state-kicker">{{organizationName}} · 校区管理端</text
        ><text class="page-title">{{displayName}}，教务概览</text
        ><text class="hero-copy"
          >小程序查看状态与待办，课程、课包和复杂排课在PC完成</text
        ></view
      ><view class="content"
        ><view class="manager-grid"
          ><view><text>课程</text><b>{{managerSummary.courseCount}}</b></view
          ><view><text>班级</text><b>{{managerSummary.classCount}}</b></view
          ><view
            ><text>在读学员</text
            ><b>{{managerSummary.studentCount}}</b></view
          ><view
            ><text>待确认学员</text
            ><b>{{managerSummary.pendingStudentCount}}</b></view
          ></view
        ><view class="section-card"
          ><view class="section-head"
            ><text>当前待办</text
            ><text>{{managerSummary.pendingReviewCount}}项审核</text></view
          ><button class="manager-entry" bindtap="openPcNotice">
            PC端处理教务任务</button
          ><button class="manager-entry" bindtap="openPcNotice">
            PC端管理学员</button
          ><button class="manager-entry" bindtap="openPcNotice">
            PC端管理排课
          </button></view
        ><text class="error-copy" wx:if="{{errorMessage}}"
          >{{errorMessage}}</text
        ></view
      ></view
    >
    <view class="bottom-space"></view> </scroll-view
  ><sxf-tabbar active="education" wx:if="{{showTabbar}}" />
</view>

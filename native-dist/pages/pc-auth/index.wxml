<view class="page">
  <view class="hero"><view class="mark">⌁</view><text class="eyebrow">赛小蜂篮球</text><text class="title">确认 PC 后台登录</text><text class="desc">扫描电脑端二维码后，确认微信身份并继续组织开户。</text></view>
  <view class="panel"><text class="status">{{status}}</text><text class="detail">{{detail}}</text><button wx:if="{{challengeId}}" class="scan" loading="{{loading}}" bindtap="confirmCurrentLogin">确认登录这台电脑</button><button wx:else class="scan" loading="{{loading}}" bindtap="scanCode">扫一扫确认登录</button></view>
</view>

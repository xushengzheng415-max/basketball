page{min-height:100%;background:#090e12;color:#f6f8f9}.page{min-height:100vh;padding:90rpx 44rpx}.hero{text-align:center}.mark{width:108rpx;height:108rpx;line-height:108rpx;margin:0 auto 28rpx;border-radius:32rpx;background:linear-gradient(145deg,#ff9700,#ff6200);font-size:58rpx;font-weight:900}.eyebrow{display:block;color:#ff8a20;font-size:24rpx;font-weight:800;letter-spacing:5rpx}.title{display:block;margin-top:18rpx;font-size:48rpx;font-weight:900}.desc{display:block;margin-top:22rpx;color:#91a0a9;font-size:28rpx;line-height:1.8}.panel{margin-top:80rpx;padding:42rpx 34rpx;border:1rpx solid #30404a;border-radius:28rpx;background:#141d23}.status{display:block;font-size:34rpx;font-weight:800}.detail{display:block;min-height:76rpx;margin-top:18rpx;color:#9ba9b0;font-size:26rpx;line-height:1.7}.scan{margin-top:36rpx;border:0;border-radius:16rpx;background:linear-gradient(135deg,#ff9000,#ff6200);color:#fff;font-size:30rpx;font-weight:800}

<view class="page">
  <view class="nav" style="padding-right: {{capsuleRight}}rpx;"><view class="back" bindtap="goBack">‹</view><text>{{pageTitle}}</text></view>
  <view class="scenario-banner {{scenarioType}}"><text class="scenario-name">{{scenarioLabel}}</text><text class="scenario-hint">{{scenarioHint}}</text></view>
  <view class="form-card">
    <text class="section-title">赛事信息</text>
    <view class="field"><text class="label required">赛事名称</text><input value="{{form.name}}" placeholder="{{namePlaceholder}}" data-field="name" bindinput="onInput" /></view>
    <view wx:if="{{showOrganizationField}}" class="field"><text class="label">{{organizationLabel}}</text><input value="{{form.organizationName}}" placeholder="{{organizationPlaceholder}}" data-field="organizationName" bindinput="onInput" /></view>
    <view wx:if="{{showClassFields}}" class="class-fields">
      <view class="field"><text class="label required">学校</text><input value="{{form.schoolName}}" placeholder="请输入学校名称" disabled="{{editingLocked}}" data-field="schoolName" bindinput="onInput" /></view>
      <view class="two-columns">
        <view class="field"><text class="label required">学段</text><picker mode="selector" range="{{stageOptions}}" value="{{stageIndex}}" disabled="{{editingLocked}}" bindchange="onStageChange"><view class="picker-control"><text>{{stageText}}</text><text>›</text></view></picker></view>
        <view class="field"><text class="label required">比赛年级</text><picker mode="selector" range="{{gradeLabels}}" value="{{gradeIndex}}" disabled="{{editingLocked}}" bindchange="onGradeChange"><view class="picker-control"><text>{{gradeText}}</text><text>›</text></view></picker></view>
      </view>
    </view>
    <view class="field"><text class="label">赛事说明</text><textarea value="{{form.description}}" maxlength="200" placeholder="{{descriptionPlaceholder}}" data-field="description" bindinput="onInput" /></view>
  </view>
  <view class="form-card">
    <view class="section-head"><text class="section-title">本队信息</text><text class="section-note">确认创建者自己的参赛队</text></view>
    <view wx:if="{{showClassFields}}" class="field"><text class="label required">本班班级</text><picker mode="selector" range="{{classOptions}}" value="{{classIndex}}" disabled="{{editingLocked}}" bindchange="onClassChange"><view class="picker-control"><text>{{classText}}</text><text>›</text></view></picker></view>
    <view wx:if="{{showCustomClassInput}}" class="field"><text class="label required">自定义班级</text><input value="{{form.className}}" placeholder="例如国际班、体育特长班" disabled="{{editingLocked}}" data-field="className" bindinput="onInput" /></view>
    <text wx:if="{{showClassFields}}" class="binding-hint">{{classBindingHint}}</text>
    <view class="field"><text class="label">{{teamPickerLabel}}</text><picker wx:if="{{teams.length}}" mode="selector" range="{{teams}}" range-key="name" value="{{teamIndex}}" disabled="{{editingLocked}}" bindchange="onTeamChange"><view class="picker-control"><text>{{selectedTeamText}}</text><text>›</text></view></picker></view>
    <view wx:if="{{showTeamEmpty}}" class="team-empty"><text>球队库还没有可用球队</text><button bindtap="goCreateTeam">先去创建球队</button></view>
    <view wx:if="{{hasSelectedTeam}}" class="roster-summary"><text>{{selectedTeamText}}</text><text>已带入 {{selectedPlayerCount}} 名球员</text></view>
    <text wx:if="{{showClassFields}}" class="field-tip">赛事保存后，班级身份与球队建立稳定绑定；再次参加同一班级赛事时会自动复用。</text><text wx:if="{{showEditLockedNote}}" class="lock-tip">对阵已发布：为保护历史赛程，班级/球队、赛制、积分和分组设置已锁定。</text>
  </view>
  <view class="form-card">
    <text class="section-title">赛制设置</text>
    <view class="field"><text class="label required">赛事赛制</text><picker mode="selector" range="{{formats}}" value="{{formatIndex}}" disabled="{{editingLocked}}" bindchange="onFormatChange"><view class="picker-control"><text>{{selectedFormatText}}</text><text>›</text></view></picker></view>
    <view wx:if="{{showGroupFields}}" class="two-columns"><view class="number-field"><text>分组数</text><view class="stepper"><button data-field="groupCount" data-delta="-1" disabled="{{editingLocked}}" bindtap="changeNumber">−</button><text>{{form.groupCount}}</text><button data-field="groupCount" data-delta="1" disabled="{{editingLocked}}" bindtap="changeNumber">+</button></view></view><view class="number-field"><text>每组晋级</text><view class="stepper"><button data-field="advanceCount" data-delta="-1" disabled="{{editingLocked}}" bindtap="changeNumber">−</button><text>{{form.advanceCount}}</text><button data-field="advanceCount" data-delta="1" disabled="{{editingLocked}}" bindtap="changeNumber">+</button></view></view></view>
    <text class="sub-title">积分规则</text><view class="points-grid"><view class="number-field"><text>胜</text><view class="stepper"><button data-field="winPoints" data-delta="-1" disabled="{{editingLocked}}" bindtap="changeNumber">−</button><text>{{form.winPoints}}</text><button data-field="winPoints" data-delta="1" disabled="{{editingLocked}}" bindtap="changeNumber">+</button></view></view><view class="number-field"><text>负</text><view class="stepper"><button data-field="lossPoints" data-delta="-1" disabled="{{editingLocked}}" bindtap="changeNumber">−</button><text>{{form.lossPoints}}</text><button data-field="lossPoints" data-delta="1" disabled="{{editingLocked}}" bindtap="changeNumber">+</button></view></view><view class="number-field"><text>弃权</text><view class="stepper"><button data-field="forfeitPoints" data-delta="-1" disabled="{{editingLocked}}" bindtap="changeNumber">−</button><text>{{form.forfeitPoints}}</text><button data-field="forfeitPoints" data-delta="1" disabled="{{editingLocked}}" bindtap="changeNumber">+</button></view></view></view>
    <text class="field-tip">排名依次比较积分、相互战绩、净胜分和总得分。</text>
  </view>
  <view class="bottom-actions"><button wx:if="{{showDraftAction}}" class="draft" data-status="draft" bindtap="submit">保存草稿</button><button class="{{primaryActionClass}}" data-status="recruiting" bindtap="submit">{{submitPrimaryText}}</button></view>
</view>

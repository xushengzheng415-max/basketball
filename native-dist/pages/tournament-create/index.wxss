page{background:#090c0f;color:#f5f7f8}.page{min-height:100vh;padding-bottom:170rpx;background:radial-gradient(circle at 100% 0,rgba(255,105,0,.18),transparent 28%),#090c0f;font-family:"PingFang SC","Microsoft YaHei",sans-serif}.nav{display:flex;height:96rpx;align-items:center;padding-top:72rpx;padding-left:24rpx;border-bottom:1rpx solid #252b30;font-size:31rpx;font-weight:900}.back{display:flex;width:62rpx;height:62rpx;align-items:center;justify-content:center;margin-right:14rpx;border-radius:50%;background:#1d2328;font-size:48rpx;font-weight:400}.scenario-banner{display:flex;flex-direction:column;margin:24rpx;padding:28rpx;border:1rpx solid #754015;border-radius:20rpx;background:linear-gradient(135deg,#38200f,#151312)}.scenario-banner.institution_weekly{border-color:#1d6456;background:linear-gradient(135deg,#173c35,#111918)}.scenario-banner.other{border-color:#424a50;background:linear-gradient(135deg,#272d32,#15191c)}.scenario-name{font-size:34rpx;font-weight:900}.scenario-hint{margin-top:10rpx;color:#abb3b9;font-size:22rpx;line-height:1.6}.form-card{margin:18rpx 24rpx;padding:28rpx;border:1rpx solid #2d3439;border-radius:20rpx;background:#14191d}.section-head{display:flex;align-items:center;justify-content:space-between}.section-title{display:block;font-size:29rpx;font-weight:900}.section-note{color:#7f8990;font-size:19rpx}.field{margin-top:26rpx}.label,.sub-title{display:block;margin-bottom:12rpx;color:#c9ced2;font-size:22rpx;font-weight:700}.required::after{margin-left:5rpx;color:#ff6a00;content:"*"}.field input,.field textarea,.picker-control{box-sizing:border-box;width:100%;border:1rpx solid #343c42;border-radius:13rpx;color:#f5f7f8;background:#0c1013;font-size:25rpx}.field input{height:82rpx;padding:0 20rpx}.field textarea{height:140rpx;padding:20rpx}.picker-control{display:flex;height:82rpx;align-items:center;justify-content:space-between;padding:0 20rpx}.picker-control text:last-child{color:#ff852b;font-size:34rpx}.two-columns{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.team-empty{display:flex;align-items:center;justify-content:space-between;margin-top:22rpx;padding:22rpx;border-radius:13rpx;background:#0c1013;color:#818b92;font-size:22rpx}.team-empty button{height:60rpx;margin:0;padding:0 20rpx;border:0;border-radius:30rpx;color:#fff;background:#ff6500;font-size:21rpx;line-height:60rpx}.team-empty button::after{border:0}.roster-summary{display:flex;justify-content:space-between;margin-top:14rpx;color:#5fd6b7;font-size:20rpx}.field-tip{display:block;margin-top:16rpx;color:#768188;font-size:20rpx;line-height:1.55}.sub-title{margin-top:30rpx}.points-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.number-field{margin-top:22rpx;padding:15rpx;border-radius:12rpx;background:#0c1013;text-align:center}.number-field>text{display:block;margin-bottom:12rpx;color:#8c969d;font-size:20rpx}.stepper{display:flex;align-items:center;justify-content:center;gap:12rpx}.stepper button{display:flex;width:48rpx;height:48rpx;align-items:center;justify-content:center;margin:0;padding:0;border:0;border-radius:50%;color:#ff852b;background:#292017;font-size:27rpx;line-height:48rpx}.stepper button::after{border:0}.stepper text{min-width:28rpx;font-size:24rpx;font-weight:900}.bottom-actions{position:fixed;left:0;right:0;bottom:0;z-index:10;display:grid;grid-template-columns:210rpx 1fr;gap:16rpx;padding:18rpx 24rpx calc(env(safe-area-inset-bottom) + 18rpx);border-top:1rpx solid #283036;background:rgba(9,12,15,.96)}.bottom-actions button{height:86rpx;border:0;border-radius:43rpx;font-size:26rpx;font-weight:900;line-height:86rpx}.bottom-actions button::after{border:0}.draft{color:#ff8b35;background:#2e2117}.primary{color:#fff;background:linear-gradient(90deg,#ff7a10,#ff5700)}

.binding-hint{display:block;margin-top:16rpx;padding:15rpx 18rpx;border-radius:11rpx;color:#5fd6b7;background:#102a24;font-size:20rpx;line-height:1.55}
.lock-tip{display:block;margin-top:16rpx;padding:15rpx 18rpx;border-radius:11rpx;color:#d2a971;background:#2c2114;font-size:20rpx;line-height:1.55}.bottom-actions .full{grid-column:1/-1}

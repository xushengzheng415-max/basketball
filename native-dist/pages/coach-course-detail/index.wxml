<view class="page"
  ><view class="nav" style="padding-top:{{navTop}}px;height:{{navHeight}}px"
    ><button bindtap="goBack">返回</button><text>课堂详情</text></view
  ><scroll-view class="scroll" scroll-y enhanced show-scrollbar="{{false}}"
    ><view style="height:{{navSpacer}}px"></view
    ><view class="loading" wx:if="{{loading}}">正在读取课堂…</view
    ><view class="error" wx:elif="{{error}}"
      ><text>{{error}}</text><button bindtap="load">重新加载</button></view
    ><view class="content" wx:else
      ><view class="hero"
        ><text>{{lessonTitle}}</text
        ><text>{{lesson.courseName}}</text
        ><view
          ><text>{{lesson.lessonDate}}</text><text>{{lesson.startTime}}</text
          ><text>{{lesson.plannedMinutes}}分钟</text></view
        ><text>{{venueText}}</text></view
      ><view class="card"
        ><view class="title"
          ><text>课堂状态</text
          ><text>{{reviewStatus}}</text></view
        ><view class="grid"
          ><view><text>应到学员</text><b>{{students.length}}人</b></view
          ><view><text>授课场地</text><b>{{venueText}}</b></view
          ><view><text>课堂版本</text><b>第{{versionNumber}}版</b></view
          ><view
            ><text>提交状态</text><b>{{submissionStatus}}</b></view
          ></view
        ></view
      ><view class="card"
        ><view class="title"
          ><text>学员名单</text><text>{{students.length}}人</text></view
        ><view class="student" wx:for="{{students}}" wx:key="studentId"
          ><view>{{item.initial}}</view><text>{{item.name}}</text
          ><text>{{item.genderText}}</text></view
        ><view class="empty" wx:if="{{studentsEmpty}}"
          >班级暂无学员</view
        ></view
      ><view class="actions"
        ><button bindtap="openAttendance">进入点名</button
        ><button bindtap="openEvaluation">课后评价</button></view
      ></view
    ><view class="safe"></view></scroll-view
></view>

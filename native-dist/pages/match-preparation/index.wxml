<view class="page"><view class="nav"><text bindtap="goBack">‹ 返回</text><b>比赛准备</b><text></text></view><view wx:if="{{loading}}" class="loading">正在读取比赛状态...</view><block wx:else><view class="hero"><text>{{statusText}}</text><b>{{ctx.home.name}}　VS　{{ctx.away.name}}</b><span>{{ctx.tournament.periodCount}}节 · 每节{{ctx.tournament.periodMinutes}}分钟</span></view>
<view class="steps"><view><b>裁判</b><text>{{ctx.preparation.refereeStatus}}</text></view><view><b>主队</b><text>{{homeReadyText}}</text></view><view><b>客队</b><text>{{awayReadyText}}</text></view></view>
<view wx:if="{{showAssignReferee}}" class="card"><b>指派计分板操作者</b><text>双方负责人不能担任本场裁判</text><picker wx:if="{{candidates.length}}" range="{{candidates}}" range-key="name" bindchange="onCandidate"><view class="picker">{{currentCandidateName}} ›</view></picker><button wx:if="{{candidates.length}}" bindtap="assignInternal">指派内部裁判</button><button class="secondary" loading="{{actionLoading}}" bindtap="inviteExternal">生成外部裁判邀请</button><image wx:if="{{externalQr}}" class="referee-qr" src="{{externalQr}}" mode="aspectFit" show-menu-by-longpress="true"/><text wx:if="{{externalPath}}" class="tip">邀请链接已复制，也可长按二维码或点击右上角转发</text></view>
<view wx:if="{{showExternalAccept}}" class="card"><b>接受裁判授权</b><input placeholder="请输入裁判姓名" bindinput="onRefereeName"/><button bindtap="acceptReferee">接受本场任务</button></view>
<view wx:if="{{showRefereeTask}}" class="card"><b>裁判任务</b><button bindtap="acceptReferee">接受任务</button><button class="secondary" bindtap="rejectReferee">拒绝</button></view>
<view wx:if="{{showCoachPreparation}}" class="card"><view class="roster-head"><b>本队比赛名单</b><button wx:if="{{showRosterEditor}}" class="refresh-roster" loading="{{actionLoading}}" bindtap="refreshRosterPlayers">刷新球员</button></view><block wx:if="{{showRosterEditor}}"><text>{{playerSourceText}} · 选择5名首发，其余自动进入替补席</text><view class="players"><view wx:for="{{myPlayers}}" wx:key="pickerId" class="player {{item.selectedClass}}" data-id="{{item.pickerId}}" bindtap="togglePlayer"><text>#{{item.number}} {{item.name}}</text><text class="selection-indicator">{{item.selectionText}}</text></view></view><button wx:if="{{showSubmitRoster}}" bindtap="submitRoster">提交首发与替补</button><button class="secondary" bindtap="skipRoster">本场不记录球员</button></block><view wx:if="{{showSubmittedRoster}}" class="roster-result"><b>名单已提交并锁定</b><text>{{submittedRosterText}}</text></view><view wx:if="{{showSkippedRoster}}" class="roster-result skipped"><b>本场不记录球员</b><text>本场仍可查看比分、时间、申请暂停和使用战术板。</text></view><button wx:if="{{rosterMode}}" class="ready" disabled="{{ready}}" bindtap="setReady">{{readyButtonText}}</button></view>
<button wx:if="{{showCoachWorkspace}}" class="workspace-entry" bindtap="goCoachWorkspace">设置教练团队与分工</button><view wx:if="{{showRefereeReady}}" class="card"><b>裁判准备</b><text>双方教练就绪后由你启动比赛</text><button disabled="{{!canStart}}" loading="{{actionLoading}}" bindtap="start">开始比赛</button></view><button wx:if="{{showCoachLive}}" class="live" bindtap="goLive">进入教练比赛端</button>
<view wx:if="{{showRestart}}" class="card restart-card"><b>重新开始本场</b><text>仅用于测试重开或确认作废原赛果后重新比赛。</text><button class="danger" loading="{{actionLoading}}" bindtap="restart">清空本场并重新准备</button></view></block></view>

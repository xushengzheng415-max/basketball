page{background:#070b0e;color:#f5f7f8}.page{min-height:100vh;padding:0 24rpx 50rpx;background:radial-gradient(circle at 100% 0,rgba(255,105,0,.2),transparent 30%),#070b0e}.nav{height:96rpx;padding-top:70rpx;display:flex;align-items:center;justify-content:space-between}.nav b{font-size:30rpx}.hero,.card,.steps{margin-top:20rpx;border:1rpx solid #303a40;border-radius:20rpx;background:#141a1e}.hero{padding:28rpx}.hero text,.hero span,.card>text{display:block;color:#8f9aa0;font-size:21rpx}.hero b{display:block;margin:12rpx 0;font-size:34rpx}.steps{display:grid;grid-template-columns:repeat(3,1fr);padding:18rpx}.steps view{text-align:center;border-right:1rpx solid #30383d}.steps view:last-child{border:0}.steps b,.steps text{display:block}.steps text{margin-top:8rpx;color:#55d8b6;font-size:20rpx}.card{padding:26rpx}.card>b{display:block;font-size:28rpx}.card>text{margin-top:9rpx}.picker,input{box-sizing:border-box;width:100%;height:76rpx;margin-top:18rpx;padding:0 18rpx;border:1rpx solid #3b454b;border-radius:12rpx;background:#0c1114;line-height:76rpx}.card button,.live{width:100%;height:76rpx;margin-top:18rpx;border:0;border-radius:38rpx;color:#fff;background:linear-gradient(90deg,#ff7910,#ff5700);font-weight:900}.card button.secondary{color:#ff9b52;background:#302117}.card button.ready,.live{background:linear-gradient(90deg,#168b6f,#1caf88)}button[disabled]{opacity:.35}.players{display:grid;grid-template-columns:1fr 1fr;gap:10rpx;margin-top:18rpx}.player{position:relative;min-height:42rpx;padding:15rpx 52rpx 15rpx 15rpx;border:2rpx solid #343d43;border-radius:12rpx;color:#aeb7bc;background:#0c1114}.player.selected{border-color:#ff7200;color:#fff;background:#2b1b10;box-shadow:0 0 0 2rpx rgba(255,114,0,.15),0 0 18rpx rgba(255,114,0,.22)}.selection-indicator{position:absolute;top:50%;right:14rpx;width:30rpx;height:30rpx;margin-top:-15rpx;border:2rpx solid #505b61;border-radius:50%;color:transparent;text-align:center;font-size:22rpx;line-height:28rpx}.player.selected .selection-indicator{border-color:#ff7200;color:#fff;background:#ff7200}.tip{color:#ff9b52!important}.loading{padding:200rpx 0;text-align:center;color:#89949a}
.referee-qr{display:block;width:300rpx;height:300rpx;margin:18rpx auto 0;border-radius:12rpx;background:#fff}
.restart-card{border-color:#70332f;background:#211412}.card button.danger{background:linear-gradient(90deg,#b6372f,#e05245)}
.roster-head{display:flex;align-items:center;justify-content:space-between}.roster-head>b{font-size:28rpx}.card .refresh-roster{width:auto;height:52rpx;margin:0;padding:0 22rpx;border:1rpx solid #ff7a21;border-radius:26rpx;color:#ff9b52;background:#24170f;font-size:21rpx;line-height:52rpx}.roster-result{margin-top:18rpx;padding:20rpx;border:1rpx solid #286c5b;border-radius:14rpx;background:#0c211b}.roster-result b,.roster-result text{display:block}.roster-result b{color:#55d8b6;font-size:25rpx}.roster-result text{margin-top:10rpx;color:#aab6b2;font-size:21rpx;line-height:1.55}.roster-result.skipped{border-color:#554334;background:#1d1712}.roster-result.skipped b{color:#ff9b52}
.workspace-entry{width:calc(100% - 48rpx);height:76rpx;margin:20rpx 24rpx 0;border:0;border-radius:38rpx;color:#fff;background:linear-gradient(90deg,#ff7910,#ff5700);font-weight:900}

<view class="page"><image class="court" src="{{court}}" mode="aspectFill"/><canvas id="board" type="2d" class="board" disable-scroll="true" bindtouchstart="start" catchtouchmove="move" bindtouchend="end"/><view class="markers"><view wx:for="{{markers}}" wx:key="id" class="{{item.className}}" style="left:{{item.x}}%;top:{{item.y}}%" data-id="{{item.id}}" bindtouchstart="markerStart" catchtouchmove="markerMove" bindtouchend="markerEnd">{{item.label}}</view></view><view class="top"><text bindtap="goBack">‹ 返回</text><b>本队私有战术板</b><input placeholder="战术名称" bindinput="onName"/></view><view class="tools"><button data-mode="draw" bindtap="setMode">画</button><button data-mode="pass" bindtap="setMode">传</button><button data-mode="defense" bindtap="setMode">防</button><button bindtap="undo">撤</button><button bindtap="clear">清</button><button bindtap="save">保存</button><button bindtap="saveLibrary">入库</button></view></view>

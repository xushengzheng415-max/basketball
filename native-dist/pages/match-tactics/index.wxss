page{background:#05080b}.page{position:relative;width:100vw;height:100vh;overflow:hidden}.court,.board{position:absolute;inset:0;width:100%;height:100%}.court{opacity:.94}.board{z-index:2}.top{position:absolute;z-index:5;left:18rpx;right:18rpx;top:12rpx;display:grid;grid-template-columns:120rpx 1fr 220rpx;align-items:center;padding:12rpx 18rpx;border-radius:14rpx;color:#fff;background:rgba(5,9,12,.82)}.top b{text-align:center}.top input{height:50rpx;padding:0 12rpx;border-radius:8rpx;color:#fff;background:#20282d}.tools{position:absolute;z-index:6;left:50%;bottom:16rpx;transform:translateX(-50%);display:flex;gap:8rpx;padding:8rpx;border-radius:40rpx;background:rgba(5,9,12,.86)}.tools button{height:54rpx;margin:0;padding:0 18rpx;border:0;border-radius:27rpx;color:#fff;background:#283137;font-size:20rpx}.markers{position:absolute;inset:0;z-index:4;pointer-events:none}.marker{position:absolute;display:flex;width:48rpx;height:48rpx;align-items:center;justify-content:center;border-radius:50%;color:#fff;font-weight:900;transform:translate(-50%,-50%)}.marker.own{border:3rpx solid #fff;background:#ff6500}.marker.away{border:3rpx solid #ff6500;background:#111}
.tools{bottom:8rpx!important;gap:5rpx!important;padding:5rpx!important;border-radius:28rpx!important}.tools button{width:62rpx!important;height:44rpx!important;padding:0!important;border-radius:22rpx!important;font-size:17rpx!important;line-height:44rpx!important}.marker{pointer-events:auto}

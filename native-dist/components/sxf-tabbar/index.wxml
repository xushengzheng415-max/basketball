<view class="sxf-tabbar">
  <view wx:for="{{items}}" wx:key="key" class="tab-item {{item.activeClass}}" hover-class="tab-item-press" hover-stay-time="80" data-key="{{item.key}}" bindtap="onTabTap">
    <view class="tab-icon-wrap"><image class="tab-icon" src="{{item.iconSrc}}" mode="aspectFit" /><text wx:if="{{item.showBadge}}" class="tab-badge">{{item.badgeText}}</text></view>
    <text>{{item.label}}</text>
  </view>
</view>
